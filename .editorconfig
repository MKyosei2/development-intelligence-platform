root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.sln]
end_of_line = crlf

[*.{json,jsonl,yml,yaml,xml,props,targets,csproj}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4

# C# language conventions
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion

csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

[*.py]
indent_size = 4

[*.{cpp,c,h,hpp}]
indent_size = 4

[*.{sh,bash}]
indent_size = 2

# BEGIN DIP SOURCE NAMING RULES

[*.cs]
# Types, methods, properties, events and public members use PascalCase.
dotnet_naming_rule.dip_types_pascal.symbols = dip_types
dotnet_naming_rule.dip_types_pascal.style = dip_pascal
dotnet_naming_rule.dip_types_pascal.severity = suggestion

dotnet_naming_symbols.dip_types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.dip_types.applicable_accessibilities = *

dotnet_naming_style.dip_pascal.capitalization = pascal_case

# Interfaces start with I and use PascalCase.
dotnet_naming_rule.dip_interfaces.symbols = dip_interfaces
dotnet_naming_rule.dip_interfaces.style = dip_interface_style
dotnet_naming_rule.dip_interfaces.severity = suggestion

dotnet_naming_symbols.dip_interfaces.applicable_kinds = interface
dotnet_naming_symbols.dip_interfaces.applicable_accessibilities = *

dotnet_naming_style.dip_interface_style.required_prefix = I
dotnet_naming_style.dip_interface_style.capitalization = pascal_case

# Private fields use _camelCase.
dotnet_naming_rule.dip_private_fields.symbols = dip_private_fields
dotnet_naming_rule.dip_private_fields.style = dip_private_field_style
dotnet_naming_rule.dip_private_fields.severity = suggestion

dotnet_naming_symbols.dip_private_fields.applicable_kinds = field
dotnet_naming_symbols.dip_private_fields.applicable_accessibilities = private

dotnet_naming_style.dip_private_field_style.required_prefix = _
dotnet_naming_style.dip_private_field_style.capitalization = camel_case

# Methods and properties use PascalCase.
dotnet_naming_rule.dip_members_pascal.symbols = dip_members
dotnet_naming_rule.dip_members_pascal.style = dip_pascal
dotnet_naming_rule.dip_members_pascal.severity = suggestion

dotnet_naming_symbols.dip_members.applicable_kinds = method, property, event
dotnet_naming_symbols.dip_members.applicable_accessibilities = *

# END DIP SOURCE NAMING RULES
