# Normalize text files to LF by default.
* text=auto eol=lf

# Visual Studio solution and Windows command files.
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit source and configuration formats.
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.dll binary
*.exe binary
*.pdb binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.mb binary
*.fbx binary
*.blend binary
