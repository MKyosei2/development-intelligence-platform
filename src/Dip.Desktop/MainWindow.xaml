<Window x:Class="Dip.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Development Intelligence Platform"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#C8C8C8" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Active project" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                          DisplayMemberPath="Name" MinHeight="30" SelectionChanged="ProjectSelectionChanged"/>
                <Button Grid.Column="2" Content="Refresh projects" Click="RefreshProjectsClicked"/>
                <Button Grid.Column="3" Content="Refresh view" Click="RefreshViewClicked"/>
                <TextBlock Grid.Column="4" Text="Native Windows GUI · external AI disabled" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding Endpoint}"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#C8C8C8" BorderThickness="0,0,1,0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="DIP Capabilities" FontWeight="Bold" FontSize="16" Margin="6,4,6,10"/>
                    <ListBox ItemsSource="{Binding Capabilities}" SelectedItem="{Binding SelectedCapability}"
                             SelectionChanged="CapabilitySelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" Margin="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.65"/>
                                        <TextBlock Text="{Binding VerificationState}" FontSize="10" Opacity="0.55"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{Binding SelectedCapability.DisplayName}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedCapability.Description}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#F4F4F4" Padding="8" Margin="0,0,0,8">
                    <TextBlock Text="A page/API failure is shown here as evidence; it does not terminate the desktop shell."/>
                </Border>

                <TextBox Grid.Row="2" Text="{Binding Content}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
