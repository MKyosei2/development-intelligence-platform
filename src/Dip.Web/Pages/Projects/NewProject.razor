@page "/projects/new"
@using System.ComponentModel.DataAnnotations
@using Dip.Application.Features.Projects
@inject ApiClient Api
@inject NavigationManager Navigation
@inject ProjectState Projects

<PageTitle>New Project | DIP</PageTitle>

<section class="page-heading narrow-heading" data-testid="manual-project-page">
    <div>
        <div class="eyebrow">Manual project setup</div>
        <h1>Create project manually</h1>
        <p>Use this only when the repository is not available through the GitHub App. GitHub repositories should normally be imported from the repository picker.</p>
    </div>
    <div class="heading-actions"><a class="btn btn-primary" href="/projects/import/github">Import from GitHub</a></div>
</section>

<div class="form-shell">
    <div class="card">
        <div class="card-header"><strong>Project identity</strong><span>Required</span></div>
        <div class="card-body">
            @if (_error is not null) { <div class="alert alert-danger">@_error</div> }
            <EditForm Model="_model" OnValidSubmit="CreateAsync" data-testid="manual-project-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                <div class="form-group">
                    <label class="form-label" for="project-name">Project name</label>
                    <InputText id="project-name" class="form-control" @bind-Value="_model.Name" placeholder="Example: Character Pipeline" />
                    <div class="form-text">Displayed in the portfolio and management dashboard.</div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="repository-url">Repository URL</label>
                    <InputText id="repository-url" class="form-control" @bind-Value="_model.RepositoryUrl" placeholder="https://github.com/owner/repository" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="default-branch">Default branch</label>
                        <InputText id="default-branch" class="form-control" @bind-Value="_model.DefaultBranch" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="release-date">Target release date</label>
                        <InputDate id="release-date" class="form-control" @bind-Value="_model.ReleaseDate" />
                        <div class="form-text">Optional.</div>
                    </div>
                </div>

                <div class="form-actions">
                    <a class="btn btn-outline-secondary" href="/">Cancel</a>
                    <button class="btn btn-primary" data-testid="create-project-submit" type="submit" disabled="@_saving">@(_saving ? "Creating…" : "Create project")</button>
                </div>
            </EditForm>
        </div>
    </div>

    <aside class="form-aside">
        <div class="callout">
            <strong>What happens next?</strong>
            <ol>
                <li>The project is persisted in PostgreSQL.</li>
                <li>Authenticated creators become Project Owner.</li>
                <li>Project Truth, Intelligence and QA Governance become available immediately.</li>
            </ol>
        </div>
    </aside>
</div>

@code {
    private readonly NewProjectModel _model = new();
    private bool _saving;
    private string? _error;

    private async Task CreateAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            DateTimeOffset? release = _model.ReleaseDate is { } date
                ? new DateTimeOffset(DateTime.SpecifyKind(date.Date, DateTimeKind.Utc))
                : null;
            var created = await Api.CreateProjectAsync(new CreateProjectCommand(
                _model.Name.Trim(),
                _model.RepositoryUrl.Trim(),
                _model.DefaultBranch.Trim(),
                release));
            await Projects.RefreshAsync();
            Projects.Select(created.Id);
            Navigation.NavigateTo($"/dashboard/{created.Id}");
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

    private sealed class NewProjectModel
    {
        [Required, StringLength(200, MinimumLength = 2)] public string Name { get; set; } = string.Empty;
        [Required, Url, StringLength(2000)] public string RepositoryUrl { get; set; } = string.Empty;
        [Required, StringLength(200)] public string DefaultBranch { get; set; } = "main";
        public DateTime? ReleaseDate { get; set; }
    }
}
