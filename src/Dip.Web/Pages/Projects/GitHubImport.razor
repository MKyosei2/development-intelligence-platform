@* Purpose: Renders and coordinates this web surface and its user interactions. *@
@page "/projects/import/github"
@using System.Net.Http.Json
@using Dip.Application.Features.GitHubIntegration
@using Dip.Application.Features.Integrations
@inject ApiClient Api
@inject HttpClient Http
@inject ProjectState Projects
@inject NavigationManager Navigation

<PageTitle>Import from GitHub | DIP</PageTitle>

<section class="page-heading" data-testid="github-import-page">
    <div>
        <div class="eyebrow">Project onboarding</div>
        <h1>Import GitHub repository</h1>
        <p>Select a repository visible to a managed GitHub Connection. If no managed connection exists, DIP falls back to the legacy server-side GitHub configuration.</p>
    </div>
    <div class="heading-actions">
        <a class="btn btn-outline-secondary" href="/admin/connections">Manage connections</a>
        <a class="btn btn-outline-secondary" href="/projects/new">Manual setup</a>
    </div>
</section>

@if (_loading)
{
    <LoadingState Message="Loading GitHub repositories…" Detail="Checking managed and legacy GitHub repository access." />
}
else if (_error is not null)
{
    <ErrorState Message="@_error" Retry="LoadAsync" />
}
else if (_connection is not null && !_connection.Connected)
{
    <div class="integration-banner warning" data-testid="github-disconnected">
        <div>
            <div class="eyebrow">GitHub repository connection</div>
            <h2>Connect GitHub repository access</h2>
            <p>@_connection.Message</p>
        </div>
        <a class="btn btn-primary" href="/admin/connections">Add managed GitHub connection</a>
    </div>
    <div class="card mt-3">
        <div class="card-body">
            <strong>Recommended</strong>
            <p class="small text-muted mt-2 mb-0">Create a managed GitHub PAT/App connection from the Admin Connections page. It becomes available immediately without restarting the API. The legacy <code>DIP_GITHUB_*</code> configuration remains supported as a fallback.</p>
        </div>
    </div>
}
else
{
    <div class="integration-banner healthy mb-3" data-testid="github-connected">
        <div>
            <div class="eyebrow">GitHub connected</div>
            <strong>@ConnectionLabel</strong>
            <p class="mb-0">Mode: @_connection?.Mode · @_repositories.Count repositories loaded</p>
        </div>
        <div class="d-flex gap-2 align-items-end">
            @if (_managedConnections.Count > 0)
            {
                <div>
                    <label class="form-label small mb-1">Connection</label>
                    <select class="form-select form-select-sm"
                            value="@(_managedConnectionId?.ToString() ?? string.Empty)"
                            @onchange="ChangeConnectionAsync"
                            disabled="@_filtering">
                        @foreach (var connection in _managedConnections)
                        {
                            <option value="@connection.Id">@connection.DisplayName (@connection.HealthState)</option>
                        }
                    </select>
                </div>
            }
            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    <div class="repo-picker-toolbar card mb-3">
        <div class="card-body">
            <div class="repo-search-row">
                <div class="form-group mb-0">
                    <label class="form-label" for="repo-search">Search repositories</label>
                    <InputText id="repo-search" class="form-control" @bind-Value="_search" placeholder="Name, owner, language…" />
                </div>
                <div class="form-group mb-0">
                    <label class="form-label" for="repo-visibility">Visibility</label>
                    <select id="repo-visibility" class="form-select" @bind="_visibility">
                        <option value="all">All</option>
                        <option value="public">Public</option>
                        <option value="private">Private</option>
                    </select>
                </div>
                <button class="btn btn-primary repo-search-button" type="button" @onclick="ApplyFiltersAsync" disabled="@_filtering">
                    @(_filtering ? "Searching…" : "Search")
                </button>
            </div>
        </div>
    </div>

    @if (_repositories.Count == 0)
    {
        <EmptyState Icon="⌕" Title="No repositories found" Description="Change the filter or grant the selected GitHub connection access to another repository." />
    }
    else
    {
        <div class="repo-picker-layout">
            <div>
                <div class="section-heading">
                    <div><h2>Repositories</h2><p>Select exactly one repository to register as a DIP project.</p></div>
                    <span class="badge text-bg-secondary">@_repositories.Count</span>
                </div>
                <div class="repo-grid" data-testid="repository-grid">
                    @foreach (var repository in _repositories)
                    {
                        <RepositoryCard Repository="repository"
                                        Selected="@(_selected?.Id == repository.Id)"
                                        Disabled="@_importing"
                                        SelectedChanged="SelectRepository" />
                    }
                </div>
            </div>

            <aside class="import-panel card">
                <div class="card-header"><strong>Import project</strong></div>
                <div class="card-body">
                    @if (_selected is null)
                    {
                        <div class="import-placeholder">
                            <div class="empty-icon">↙</div>
                            <strong>Select a repository</strong>
                            <p>The repository URL and branch are copied from the selected GitHub connection.</p>
                        </div>
                    }
                    else
                    {
                        @if (_importError is not null)
                        {
                            <div class="alert alert-danger">@_importError</div>
                        }
                        <div class="selected-repository">
                            <strong>@_selected.FullName</strong>
                            <small>@_selected.HtmlUrl</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="import-name">Project name</label>
                            <InputText id="import-name" class="form-control" @bind-Value="_projectName" />
                        </div>
                        <div class="form-row compact-row">
                            <div class="form-group">
                                <label class="form-label">Default branch</label>
                                <input class="form-control" value="@_selected.DefaultBranch" disabled />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="import-release">Target release</label>
                                <InputDate id="import-release" class="form-control" @bind-Value="_releaseDate" />
                            </div>
                        </div>

                        @if (UsingManagedConnection)
                        {
                            <label class="check-row">
                                <InputCheckbox @bind-Value="_syncWorkspace" />
                                <span><strong>Synchronize connector evidence now</strong><small>Creates the ProjectSourceBinding and records the selected repository head as Unified Evidence V2.</small></span>
                            </label>
                            <div class="alert alert-info small">
                                Managed Connector import does not yet migrate the legacy archive-based initial QA workspace. The existing legacy GitHub import path remains available when no managed connection is configured.
                            </div>
                        }
                        else
                        {
                            <label class="check-row">
                                <InputCheckbox @bind-Value="_syncWorkspace" />
                                <span><strong>Synchronize workspace now</strong><small>Downloads the selected branch into the protected QA workspace.</small></span>
                            </label>
                            <label class="check-row">
                                <InputCheckbox @bind-Value="_runInitialQa" disabled="@(!_syncWorkspace)" />
                                <span><strong>Run initial QA after import</strong><small>Runs the legacy exact-revision QA flow.</small></span>
                            </label>
                        }

                        <button class="btn btn-primary w-100"
                                data-testid="import-repository-submit"
                                type="button"
                                @onclick="ImportAsync"
                                disabled="@_importing">
                            @(_importing ? "Importing…" : "Import repository")
                        </button>
                    }
                </div>
            </aside>
        </div>
    }
}

@code {
    private GitHubConnectionStatusDto? _connection;
    private IReadOnlyList<GitHubRepositorySummaryDto> _repositories =
        Array.Empty<GitHubRepositorySummaryDto>();
    private IReadOnlyList<ConnectorResourceDto> _managedResources =
        Array.Empty<ConnectorResourceDto>();
    private IReadOnlyList<IntegrationConnectionDto> _managedConnections =
        Array.Empty<IntegrationConnectionDto>();
    private Guid? _managedConnectionId;
    private GitHubRepositorySummaryDto? _selected;

    private string _search = string.Empty;
    private string _visibility = "all";
    private string _projectName = string.Empty;
    private DateTime? _releaseDate;
    private bool _syncWorkspace = true;
    private bool _runInitialQa = true;
    private bool _loading = true;
    private bool _filtering;
    private bool _importing;
    private string? _error;
    private string? _importError;

    private bool UsingManagedConnection => _managedConnectionId.HasValue;

    private string ConnectionLabel =>
        _managedConnections.FirstOrDefault(item => item.Id == _managedConnectionId)?.DisplayName
        ?? _connection?.Account
        ?? "GitHub App installation";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _managedConnections =
                await Http.GetFromJsonAsync<IReadOnlyList<IntegrationConnectionDto>>(
                    "api/v1/integrations/connections?provider=GitHub")
                ?? Array.Empty<IntegrationConnectionDto>();

            if (_managedConnections.Count > 0)
            {
                if (!_managedConnectionId.HasValue ||
                    _managedConnections.All(item => item.Id != _managedConnectionId.Value))
                {
                    _managedConnectionId =
                        _managedConnections.FirstOrDefault(item =>
                            item.HealthState == Dip.Domain.Enums.ConnectionHealthState.Healthy)?.Id
                        ?? _managedConnections[0].Id;
                }

                var selectedConnection =
                    _managedConnections.First(item => item.Id == _managedConnectionId.Value);

                _connection = new GitHubConnectionStatusDto(
                    true,
                    true,
                    $"Managed/{selectedConnection.Mode}",
                    null,
                    selectedConnection.ExternalAccount,
                    null,
                    null,
                    selectedConnection.LastHealthMessage
                        ?? "Managed GitHub connection is active.");

                await LoadManagedRepositoriesAsync();
            }
            else
            {
                _managedConnectionId = null;
                _managedResources = Array.Empty<ConnectorResourceDto>();
                _connection = await Api.GetGitHubConnectionStatusAsync();
                _repositories = _connection.Connected
                    ? await Api.GetGitHubRepositoriesAsync(_search, _visibility)
                    : Array.Empty<GitHubRepositorySummaryDto>();
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangeConnectionAsync(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var connectionId))
            return;

        _managedConnectionId = connectionId;
        _selected = null;
        _filtering = true;
        _error = null;
        try
        {
            var selectedConnection =
                _managedConnections.First(item => item.Id == connectionId);
            _connection = new GitHubConnectionStatusDto(
                true,
                true,
                $"Managed/{selectedConnection.Mode}",
                null,
                selectedConnection.ExternalAccount,
                null,
                null,
                selectedConnection.LastHealthMessage
                    ?? "Managed GitHub connection is active.");
            await LoadManagedRepositoriesAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _filtering = false; }
    }

    private async Task LoadManagedRepositoriesAsync()
    {
        if (!_managedConnectionId.HasValue)
            return;

        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(_search))
            query.Add("search=" + Uri.EscapeDataString(_search.Trim()));
        if (!string.IsNullOrWhiteSpace(_visibility))
            query.Add("visibility=" + Uri.EscapeDataString(_visibility));
        query.Add("limit=500");

        var path =
            $"api/v1/integrations/connections/{_managedConnectionId.Value}/resources"
            + "?" + string.Join("&", query);

        _managedResources =
            await Http.GetFromJsonAsync<IReadOnlyList<ConnectorResourceDto>>(path)
            ?? Array.Empty<ConnectorResourceDto>();

        _repositories = _managedResources
            .Where(item => item.ResourceType.Equals(
                "repository",
                StringComparison.OrdinalIgnoreCase))
            .Select(MapRepository)
            .ToArray();
    }

    private async Task ApplyFiltersAsync()
    {
        _filtering = true;
        _error = null;
        try
        {
            if (UsingManagedConnection)
                await LoadManagedRepositoriesAsync();
            else
                _repositories =
                    await Api.GetGitHubRepositoriesAsync(_search, _visibility);

            if (_selected is not null &&
                !_repositories.Any(item => item.Id == _selected.Id))
                _selected = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _filtering = false;
        }
    }

    private async Task SelectRepository(GitHubRepositorySummaryDto repository)
    {
        if (repository.DipProjectId is { } projectId)
        {
            await Projects.RefreshAsync();
            Projects.Select(projectId);
            Navigation.NavigateTo($"/dashboard/{projectId}");
            return;
        }

        _selected = repository;
        _projectName = repository.Name;
        _importError = null;
    }

    private async Task ImportAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_projectName))
            return;

        _importing = true;
        _importError = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            DateTimeOffset? release = _releaseDate is { } date
                ? new DateTimeOffset(DateTime.SpecifyKind(date.Date, DateTimeKind.Utc))
                : null;

            if (UsingManagedConnection)
            {
                var resource = _managedResources.First(item =>
                    item.FullName.Equals(
                        _selected.FullName,
                        StringComparison.OrdinalIgnoreCase));

                var command = new ImportConnectionProjectCommand(
                    resource.ExternalId,
                    resource.FullName,
                    _projectName.Trim(),
                    release,
                    SyncEvidence: _syncWorkspace);

                using var response = await Http.PostAsJsonAsync(
                    $"api/v1/integrations/connections/{_managedConnectionId!.Value}/import",
                    command);
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    throw new InvalidOperationException(
                        $"Import failed ({(int)response.StatusCode}): {body}");
                }

                var imported =
                    await response.Content.ReadFromJsonAsync<ImportConnectionProjectResult>()
                    ?? throw new InvalidOperationException(
                        "Managed import returned an empty response.");

                await Projects.RefreshAsync();
                Projects.Select(imported.ProjectId);
                var suffix = string.IsNullOrWhiteSpace(imported.Warning)
                    ? string.Empty
                    : "?importWarning=" + Uri.EscapeDataString(imported.Warning);
                Navigation.NavigateTo($"/dashboard/{imported.ProjectId}{suffix}");
                return;
            }

            var legacy = await Api.ImportGitHubProjectAsync(
                new ImportGitHubProjectRequest(
                    _selected.FullName,
                    _projectName.Trim(),
                    release,
                    _syncWorkspace,
                    _runInitialQa));

            await Projects.RefreshAsync();
            Projects.Select(legacy.ProjectId);

            if (legacy.InitialQaRunId is { } qaRunId)
            {
                var suffix = $"?run={qaRunId}";
                if (!string.IsNullOrWhiteSpace(legacy.Warning))
                    suffix += "&importWarning=" + Uri.EscapeDataString(legacy.Warning);
                Navigation.NavigateTo($"/dashboard/{legacy.ProjectId}/qa{suffix}");
            }
            else
            {
                var suffix = string.IsNullOrWhiteSpace(legacy.Warning)
                    ? string.Empty
                    : "?importWarning=" + Uri.EscapeDataString(legacy.Warning);
                Navigation.NavigateTo($"/dashboard/{legacy.ProjectId}{suffix}");
            }
        }
        catch (Exception exception)
        {
            _importError = exception.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    private static GitHubRepositorySummaryDto MapRepository(
        ConnectorResourceDto resource)
    {
        var id = long.TryParse(
            resource.ExternalId,
            System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture,
            out var parsed)
            ? parsed
            : Math.Abs((long)StringComparer.OrdinalIgnoreCase.GetHashCode(resource.FullName));

        var owner = resource.FullName.Contains('/')
            ? resource.FullName.Split('/', 2)[0]
            : string.Empty;

        return new GitHubRepositorySummaryDto(
            id,
            owner,
            resource.Name,
            resource.FullName,
            resource.Url ?? string.Empty,
            resource.DefaultBranch ?? "main",
            resource.Private,
            resource.Archived,
            resource.PrimaryLanguage,
            resource.Description,
            0,
            0,
            0,
            resource.UpdatedAtUtc,
            resource.DipProjectId);
    }
}
