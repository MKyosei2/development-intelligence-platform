@page "/system"
@using Dip.Application.Features.SystemStatus
@inject ApiClient Api
@inject IConfiguration Configuration

<PageTitle>System Status | DIP</PageTitle>

<section class="page-heading">
    <div>
        <div class="eyebrow">Platform operations</div>
        <h1>System Status</h1>
        <p>Separate DIP infrastructure failures from problems in the product being verified.</p>
    </div>
    <button class="btn btn-outline-primary" @onclick="RefreshAsync" disabled="@_loading">@(_loading ? "Checking…" : "Refresh")</button>
</section>

@if (_error is not null)
{
    <div class="alert alert-danger"><strong>Status API is unavailable.</strong><div>@_error</div></div>
}
else if (_status is null)
{
    <div class="empty-state"><div class="spinner"></div><strong>Checking platform services…</strong></div>
}
else
{
    <div class="overall-status @StateClass(_status.Overall)">
        <div><span class="status-orb"></span><div><span>Overall platform state</span><strong>@_status.Overall</strong></div></div>
        <small>Checked @_status.CheckedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</small>
    </div>

    <div class="status-grid">
        @foreach (var component in _status.Components)
        {
            <div class="status-card">
                <div class="status-card-head"><span class="status-dot @StateClass(component.State)"></span><span>@component.Name</span><strong>@component.State</strong></div>
                <p>@component.Detail</p>
            </div>
        }
    </div>

    <div class="card mt-4">
        <div class="card-header"><strong>Runtime endpoints</strong><span>Local one-click defaults</span></div>
        <div class="card-body endpoint-list">
            <div><span>GUI</span><code>@PublicWeb</code></div>
            <div><span>API / Swagger</span><code>@(PublicApi + "/swagger")</code></div>
            <div><span>Python Analysis</span><code>@(PublicAnalysis + "/health")</code></div>
            <div><span>Worker metrics</span><code>@(PublicWorker + "/metrics")</code></div>
        </div>
    </div>
}

@code {
    private string PublicWeb => Configuration["Ui:PublicWebUrl"] ?? "http://127.0.0.1:5081";
    private string PublicApi => Configuration["Ui:PublicApiUrl"] ?? "http://127.0.0.1:5080";
    private string PublicAnalysis => Configuration["Ui:PublicAnalysisUrl"] ?? "http://127.0.0.1:8100";
    private string PublicWorker => Configuration["Ui:PublicWorkerMetricsUrl"] ?? "http://127.0.0.1:9091";

    private SystemStatusDto? _status;
    private string? _error;
    private bool _loading;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        try { _status = await Api.GetSystemStatusAsync(); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loading = false; }
    }

    private static string StateClass(string state) => state switch
    {
        SystemComponentStates.Healthy => "healthy",
        SystemComponentStates.NotConfigured => "neutral",
        SystemComponentStates.Degraded => "warning",
        _ => "danger"
    };
}
