    private async Task LoadGitHubAsync()
    {
        _githubLoading = true;
        _githubError = null;
        try { _github = await Api.GetGitHubConnectionStatusAsync(); }
        catch (Exception exception) { _githubError = exception.Message; }
        finally { _githubLoading = false; }
    }

    private async Task TestGitHubAsync()
    {
        _githubTesting = true;
        try
        {
            _githubTest = await Api.TestGitHubConnectionAsync(_project?.Id);
            _github = await Api.GetGitHubConnectionStatusAsync();
        }
        catch (Exception exception)
        {
