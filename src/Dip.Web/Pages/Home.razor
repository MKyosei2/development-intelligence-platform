@* Purpose: Renders the H om e UI and coordinates its p ag es interactions. *@
@using Microsoft.AspNetCore.Components.Authorization
@page "/"
@inject ProjectState Projects
@inject ApiClient Api
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Dip.Application.Features.Management

<PageTitle>Portfolio | DIP</PageTitle>

<section class="page-heading" data-testid="portfolio-page">
    <div>
        <div class="eyebrow">Portfolio command center</div>
        <h1>Development Intelligence</h1>
        @if (_viewerReadOnly)
        {
            <p>Browse the live hosted portfolio. Evidence, delivery risk, QA and repository health stay scoped to the active project; changes require owner sign-in.</p>
        }
        else
        {
            <p>Select a project or import a GitHub repository. Evidence, delivery risk, QA and repository health stay scoped to the active project.</p>
        }
    </div>
    @if (!_viewerReadOnly)
    {
        <div class="heading-actions">
            <a class="btn btn-outline-secondary" href="/projects/new">Manual project</a>
            <a class="btn btn-primary" data-testid="import-github-cta" data-enhance-nav="false" href="/projects/import/github">Import from GitHub</a>
        </div>
    }
</section>

<section class="dip-intro-card" data-testid="how-dip-works">
    <div class="dip-intro-top">
        <div>
            <div class="eyebrow">How DIP works</div>
            <h2>From repository signals to evidence-backed decisions</h2>
            <p>DIP continuously turns source, CI, QA and runtime observations into evidence, then uses that evidence to explain Project Truth, delivery risk and the next action.</p>
        </div>
        <div class="dip-intro-actions">
            @if (PrimaryProjectHref is { } projectHref)
            {
                <a class="btn btn-primary" data-testid="open-primary-project" href="@projectHref">
                    @(_viewerReadOnly ? "Review project" : "Open project")
                </a>
            }
            else if (!_viewerReadOnly)
            {
                <a class="btn btn-primary" data-enhance-nav="false" href="/projects/import/github">Connect first repository</a>
                <a class="btn btn-outline-secondary" href="/projects/new">Create manually</a>
            }
        </div>
    </div>

    <div class="runtime-mode-strip" aria-label="Runtime context">
        <div class="runtime-mode">
            <span>Current Runtime</span>
            <strong>Portfolio / local runtime</strong>
            <small>This page describes the environment being viewed now; it does not claim continuous public uptime.</small>
        </div>
        <div class="runtime-mode">
            <span>Production Design Target</span>
            <strong>24/7 always-on development intelligence</strong>
            <small>Source changes are intended to feed continuous evidence collection and verification in production deployment.</small>
        </div>
    </div>

    <div class="how-dip-works">
        <div class="how-dip-works-head">
            <div>
                <div class="eyebrow">Operation model</div>
                <h3>Six steps, one evidence chain</h3>
            </div>
            <p>The project dashboard highlights the current step and one primary next action.</p>
        </div>
        <ol class="how-dip-steps">
            <li class="how-dip-step" data-testid="home-flow-connect">
                <div class="how-dip-step-number">01</div>
                <strong>Connect</strong>
                <small>Attach the project and source repository.</small>
            </li>
            <li class="how-dip-step" data-testid="home-flow-collect">
                <div class="how-dip-step-number">02</div>
                <strong>Collect</strong>
                <small>Gather source, CI, QA and runtime evidence.</small>
            </li>
            <li class="how-dip-step" data-testid="home-flow-verify">
                <div class="how-dip-step-number">03</div>
                <strong>Verify</strong>
                <small>Run QA against the synchronized workspace.</small>
            </li>
            <li class="how-dip-step" data-testid="home-flow-understand">
                <div class="how-dip-step-number">04</div>
                <strong>Understand</strong>
                <small>Evaluate Project Truth from available evidence.</small>
            </li>
            <li class="how-dip-step" data-testid="home-flow-decide">
                <div class="how-dip-step-number">05</div>
                <strong>Decide</strong>
                <small>Review blockers, contradictions and gates.</small>
            </li>
            <li class="how-dip-step" data-testid="home-flow-monitor">
                <div class="how-dip-step-number">06</div>
                <strong>Monitor</strong>
                <small>Keep evidence current as the project changes.</small>
            </li>
        </ol>
    </div>
</section>

@if (Projects.IsLoading && Projects.Projects.Count == 0)
{
    <LoadingState Message="Loading portfolio…" />
}
else if (Projects.Error is not null && Projects.Projects.Count == 0)
{
    <ErrorState Message="@Projects.Error" Retry="RefreshProjectsAsync" />
}
else if (Projects.Projects.Count == 0)
{
    @if (_viewerReadOnly)
    {
        <EmptyState Icon="◫"
                    Title="No published portfolio project yet"
                    Description="The hosted DIP stack is online, but this deployment has not been populated with a reviewer-facing project yet." />
    }
    else
    {
        <ActionableEmptyState Icon="⌘"
                              TestId="portfolio-first-project"
                              Title="Connect your first repository"
                              Why="DIP needs a project and source revision before it can collect QA evidence or evaluate Project Truth."
                              ActionText="Import from GitHub"
                              ActionHref="/projects/import/github"
                              Enables="FirstProjectCapabilities">
            <a class="btn btn-outline-secondary" href="/projects/new">Create manually</a>
        </ActionableEmptyState>
    }
}
else
{
    @if (ReviewProjectId is { } reviewProjectId)
    {
        <section class="reviewer-guide" data-testid="reviewer-guide">
            <div class="reviewer-guide-top">
                <div>
                    <div class="eyebrow">For reviewers</div>
                    <h2>DIPを5分で確認</h2>
                    <p>@(_viewerReadOnly
                        ? "変更操作を行わず、Project Truth → QA Evidence → Intelligence → Platform Operationsの順に確認できます。"
                        : "選考・レビュー時に見せる順番を、そのままReviewer Tourで確認できます。")</p>
                </div>
                <a class="btn btn-primary" data-testid="start-reviewer-tour" href="/?tour=review">Start 5-minute review</a>
            </div>
            <div class="reviewer-path">
                <a href="@($"/dashboard/{reviewProjectId}")"><span>01</span><strong>Project Overview</strong><small>Project Truth / Operation Flow</small></a>
                <a href="@($"/dashboard/{reviewProjectId}/qa")"><span>02</span><strong>QA Evidence</strong><small>revision / findings / evidence</small></a>
                <a href="@($"/dashboard/{reviewProjectId}/intelligence")"><span>03</span><strong>Intelligence</strong><small>contradictions / decisions</small></a>
                <a href="/system"><span>04</span><strong>Platform Operations</strong><small>runtime / 24-7 design target</small></a>
            </div>
        </section>
    }

    <div class="metric-grid mb-4">
        <div class="metric-card"><span>Projects</span><strong>@Projects.Projects.Count</strong><small>registered</small></div>
        <div class="metric-card"><span>At risk</span><strong>@Projects.Projects.Count(x => x.RiskLevel is "High" or "Critical")</strong><small>high / critical</small></div>
        <div class="metric-card"><span>Blocked</span><strong>@Projects.Projects.Sum(x => x.BlockerCount)</strong><small>active blockers</small></div>
        <div class="metric-card"><span>Evidence gaps</span><strong>@Projects.Projects.Sum(x => x.ContradictionCount)</strong><small>mismatches</small></div>
    </div>

    @if (_portfolio is not null)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div><strong>Program operations</strong><div class="small text-muted">Cross-project schedule, approvals, conflicts and explicit shared-resource capacity.</div></div>
                <span class="badge text-bg-secondary">@_portfolio.GeneratedAtUtc.ToLocalTime().ToString("g")</span>
            </div>
            <div class="card-body">
                <div class="metric-grid mb-3">
                    <div class="metric-card"><span>Managed</span><strong>@_portfolio.Projects</strong><small>accessible projects</small></div>
                    <div class="metric-card"><span>At risk</span><strong>@_portfolio.AtRisk</strong><small>needs review</small></div>
                    <div class="metric-card"><span>Critical</span><strong>@_portfolio.Critical</strong><small>immediate attention</small></div>
                    <div class="metric-card"><span>Shared capacity</span><strong>@_portfolio.SharedCapacityConflicts.Count</strong><small>cross-project conflicts</small></div>
                </div>
                @if (_portfolio.ExecutiveActions.Count > 0)
                {
                    <div class="alert alert-warning mb-3"><strong>Executive actions</strong><ul class="mb-0 mt-2">@foreach (var action in _portfolio.ExecutiveActions.Take(6)){<li>@action</li>}</ul></div>
                }
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Project</th><th>Health</th><th>Schedule</th><th>Capacity</th><th>Risks / blockers</th><th>Decisions / approvals</th><th>Sync</th></tr></thead>
                        <tbody>
                        @foreach (var project in _portfolio.Items)
                        {
                            <tr>
                                <td><a href="@($"/dashboard/{project.ProjectId}/management")"><strong>@project.Name</strong></a></td>
                                <td><span class="@RiskText(project.OverallStatus)">@project.OverallStatus</span><div class="small text-muted">@project.HealthScore.ToString("0.#")</div></td>
                                <td>@project.ScheduleStatus @if(project.DelayDays > 0){<span class="text-danger">+@project.DelayDays d</span>}</td>
                                <td>@project.PeakUtilizationPercent.ToString("0.#")%</td>
                                <td>@project.CriticalRisks / @project.OpenBlockers</td>
                                <td>@project.PendingDecisions / @project.PendingApprovals <span class="small text-muted">(@project.OverdueActions overdue)</span></td>
                                <td>@project.OpenSyncConflicts conflict(s)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (_portfolio.SharedCapacityConflicts.Count > 0)
                {
                    <div class="mt-3"><strong>Shared-resource pool conflicts</strong>
                    @foreach (var conflict in _portfolio.SharedCapacityConflicts)
                    {
                        <div class="attention-item warning mt-2"><span>!</span><div><strong>@conflict.TeamName: @conflict.ShortageHoursPerWeek.ToString("0.#") h/week shortage</strong><small>@string.Join(" · ", conflict.Projects)</small><div class="small">@conflict.Recommendation</div></div></div>
                    }
                    </div>
                }
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_portfolioError))
    {
        <div class="alert alert-warning">Portfolio operations data is temporarily unavailable: @_portfolioError</div>
    }

    <div class="section-heading">
        <div><h2>Projects</h2><p>Open a project to inspect the evidence-backed overview.</p></div>
        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="RefreshProjectsAsync">Refresh</button>
    </div>
    <div class="row g-3">
        @foreach (var project in Projects.Projects)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <a class="project-card" data-testid="project-card" href="@($"/dashboard/{project.ProjectId}")">
                    <div class="project-card-top">
                        <div class="project-icon">@ProjectInitial(project.Name)</div>
                        <StatusBadge Value="project.TruthStatus" />
                    </div>
                    <h3>@project.Name</h3>
                    <p class="repo-path">@ShortRepository(project.Repository)</p>
                    <div class="project-progress-row">
                        <div><span>Evidence-backed</span><strong>@project.VerifiedProgress.ToString("0.#")%</strong></div>
                        <div><span>Reported</span><strong>@FormatProgress(project.ReportedProgress)</strong></div>
                    </div>
                    <div class="progress-track"><div class="progress-fill" style="width:@Clamp(project.VerifiedProgress)%"></div></div>
                    <div class="project-meta">
                        <span><small>Risk</small><strong class="@RiskText(project.RiskLevel)">@project.RiskLevel</strong></span>
                        <span><small>CI</small><strong>@(project.LatestPipelineStatus ?? "—")</strong></span>
                        <span><small>Blockers</small><strong>@project.BlockerCount</strong></span>
                    </div>
                </a>
            </div>
        }
    </div>
}

@code {
    private PortfolioManagementDto? _portfolio;
    private string? _portfolioError;
    private bool _viewerReadOnly;

    private static readonly IReadOnlyList<string> FirstProjectCapabilities =
    [
        "Repository synchronization",
        "QA evidence collection",
        "Project Truth evaluation"
    ];

    private Guid? ReviewProjectId =>
        Projects.CurrentProjectId ?? Projects.Projects.FirstOrDefault()?.ProjectId;

    private string? PrimaryProjectHref
    {
        get
        {
            var project = Projects.CurrentProject ?? Projects.Projects.FirstOrDefault();
            return project is null ? null : $"/dashboard/{project.ProjectId}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var publicReadOnly = Configuration.GetValue<bool?>("PublicAccess:ReadOnly") ?? false;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _viewerReadOnly = publicReadOnly && authenticationState.User.Identity?.IsAuthenticated != true;
        await LoadPortfolioAsync();
    }

    private async Task RefreshProjectsAsync()
    {
        await Projects.RefreshAsync();
        await LoadPortfolioAsync();
    }

    private async Task LoadPortfolioAsync()
    {
        try
        {
            _portfolio = await Api.GetPortfolioManagementAsync();
            _portfolioError = null;
        }
        catch (Exception ex)
        {
            _portfolio = null;
            _portfolioError = ex.Message;
        }
    }

    private static string ProjectInitial(string value) => string.IsNullOrWhiteSpace(value)
        ? "P"
        : value.Trim()[0].ToString().ToUpperInvariant();
    private static string FormatProgress(decimal? value) => value is null ? "—" : $"{value:0.#}%";
    private static decimal Clamp(decimal value) => Math.Clamp(value, 0m, 100m);
    private static string RiskText(string risk) => risk switch
    {
        "High" or "Critical" => "text-danger",
        "Medium" => "text-warning",
        _ => "text-success"
    };
    private static string ShortRepository(string repository)
    {
        if (Uri.TryCreate(repository, UriKind.Absolute, out var uri))
            return uri.AbsolutePath.Trim('/');
        return repository;
    }
}
