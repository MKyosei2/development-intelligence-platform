@page "/"
@using Dip.Application.Features.Dashboard
@inject ApiClient Api

<PageTitle>Portfolio | DIP</PageTitle>

<section class="page-heading">
    <div>
        <div class="eyebrow">Portfolio command center</div>
        <h1>Development Intelligence</h1>
        <p>Objective evidence, delivery risk, QA governance and management decisions in one place.</p>
    </div>
    <div class="heading-actions">
        <a class="btn btn-outline-secondary" href="/system">System status</a>
        <a class="btn btn-primary" href="/projects/new">Create project</a>
    </div>
</section>

@if (_loading)
{
    <div class="empty-state"><div class="spinner"></div><strong>Loading projects…</strong></div>
}
else if (_error is not null)
{
    <div class="alert alert-danger">
        <strong>Could not load the portfolio.</strong>
        <div>@_error</div>
        <div class="small mt-2">Check System Status. If authentication is enabled, sign in from the sidebar.</div>
    </div>
}
else if (_projects.Count == 0)
{
    <div class="empty-state card">
        <div class="empty-icon">＋</div>
        <h2>No projects yet</h2>
        <p>Create the first project entirely from the GUI. It will automatically receive an Owner membership in authenticated mode.</p>
        <a class="btn btn-primary" href="/projects/new">Create first project</a>
    </div>
}
else
{
    <div class="metric-grid mb-4">
        <div class="metric-card"><span>Projects</span><strong>@_projects.Count</strong><small>registered</small></div>
        <div class="metric-card"><span>At risk</span><strong>@_projects.Count(x => x.RiskLevel is "High" or "Critical")</strong><small>high / critical</small></div>
        <div class="metric-card"><span>Blocked</span><strong>@_projects.Sum(x => x.BlockerCount)</strong><small>active blockers</small></div>
        <div class="metric-card"><span>Evidence gaps</span><strong>@_projects.Sum(x => x.ContradictionCount)</strong><small>mismatches</small></div>
    </div>

    <div class="section-heading"><div><h2>Projects</h2><p>Open a project to inspect evidence-backed progress and release risk.</p></div></div>
    <div class="row g-3">
        @foreach (var project in _projects)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <a class="project-card" href="@($"/dashboard/{project.ProjectId}")">
                    <div class="project-card-top">
                        <div class="project-icon">@ProjectInitial(project.Name)</div>
                        <span class="badge @TruthBadge(project.TruthStatus)">@project.TruthStatus</span>
                    </div>
                    <h3>@project.Name</h3>
                    <p class="repo-path">@project.Repository</p>
                    <div class="project-progress-row">
                        <div><span>Evidence-backed</span><strong>@project.VerifiedProgress.ToString("0.#")%</strong></div>
                        <div><span>Reported</span><strong>@FormatProgress(project.ReportedProgress)</strong></div>
                    </div>
                    <div class="progress-track"><div class="progress-fill" style="width:@Clamp(project.VerifiedProgress)%"></div></div>
                    <div class="project-meta">
                        <span><small>Risk</small><strong class="@RiskText(project.RiskLevel)">@project.RiskLevel</strong></span>
                        <span><small>Confidence</small><strong>@project.EvidenceConfidence</strong></span>
                        <span><small>Blockers</small><strong>@project.BlockerCount</strong></span>
                    </div>
                    @if (project.ReportedProgress is { } reported && reported - project.VerifiedProgress >= 20m)
                    {
                        <div class="inline-warning">Reported progress is @(reported - project.VerifiedProgress).ToString("0.#") points ahead of evidence.</div>
                    }
                </a>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ProjectDashboardSummary> _projects = Array.Empty<ProjectDashboardSummary>();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _projects = await Api.GetProjectsAsync(); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loading = false; }
    }

    private static string ProjectInitial(string value) => string.IsNullOrWhiteSpace(value) ? "P" : value.Trim()[0].ToString().ToUpperInvariant();
    private static string FormatProgress(decimal? value) => value is null ? "—" : $"{value:0.#}%";
    private static decimal Clamp(decimal value) => Math.Clamp(value, 0m, 100m);
    private static string TruthBadge(string status) => status switch { "Healthy" => "text-bg-success", "Attention" => "text-bg-warning", "AtRisk" or "Blocked" => "text-bg-danger", _ => "text-bg-secondary" };
    private static string RiskText(string risk) => risk switch { "High" or "Critical" => "text-danger", "Medium" => "text-warning", _ => "text-success" };
}
