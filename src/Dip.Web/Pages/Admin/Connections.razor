@page "/admin/connections"
@using System.Net.Http.Json
@using Dip.Application.Features.Integrations
@using Dip.Domain.Enums
@inject HttpClient Http

<PageTitle>Connections | DIP</PageTitle>

<section class="page-heading" data-testid="admin-connections-page">
    <div>
        <div class="eyebrow">Administration</div>
        <h1>Integration connections</h1>
        <p>Register runtime connections without restarting DIP. Secrets are written to the local encrypted credential store and are never returned to the browser.</p>
    </div>
    <div class="heading-actions">
        <a class="btn btn-outline-secondary" href="/projects/import/github">Open repository picker</a>
    </div>
</section>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="row g-3">
    <div class="col-xl-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Connections</strong>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
            </div>
            <div class="card-body">
                @if (_loading)
                {
                    <p class="text-muted mb-0">Loading connections…</p>
                }
                else if (_connections.Count == 0)
                {
                    <p class="text-muted mb-0">No managed connections exist yet.</p>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var connection in _connections)
                        {
                            <div class="border rounded p-3" data-testid="managed-connection-card">
                                <div class="d-flex justify-content-between gap-3">
                                    <div>
                                        <strong>@connection.DisplayName</strong>
                                        <div class="small text-muted">@connection.Provider · @connection.Mode</div>
                                        <div class="small mt-1">
                                            Health:
                                            <span class="badge text-bg-@(connection.HealthState == ConnectionHealthState.Healthy ? "success" : connection.HealthState == ConnectionHealthState.Degraded ? "warning" : "secondary")">
                                                @connection.HealthState
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(connection.ExternalAccount))
                                            {
                                                <span class="ms-2">@connection.ExternalAccount</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(connection.LastHealthMessage))
                                        {
                                            <div class="small text-muted mt-1">@connection.LastHealthMessage</div>
                                        }
                                    </div>
                                    <div class="d-flex flex-column gap-2">
                                        <button class="btn btn-outline-primary btn-sm"
                                                @onclick="() => TestAsync(connection.Id)"
                                                disabled="@_busy">
                                            Test
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm"
                                                @onclick="() => ToggleAsync(connection)"
                                                disabled="@_busy">
                                            @(connection.Enabled ? "Disable" : "Enable")
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => DeleteAsync(connection.Id)"
                                                disabled="@_busy">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                                @if (connection.LastTestedAtUtc is { } tested)
                                {
                                    <div class="small text-muted mt-2">Last tested: @tested.ToLocalTime().ToString("g")</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="card">
            <div class="card-header"><strong>Add GitHub connection</strong></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Display name</label>
                    <input class="form-control" @bind="_displayName" placeholder="Personal GitHub" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Authentication mode</label>
                    <select class="form-select" @bind="_mode">
                        <option value="@IntegrationConnectionMode.GitHubPat">GitHub PAT</option>
                        <option value="@IntegrationConnectionMode.GitHubApp">GitHub App</option>
                        <option value="@IntegrationConnectionMode.GitHubEnterprisePat">GitHub Enterprise PAT</option>
                        <option value="@IntegrationConnectionMode.GitHubEnterpriseApp">GitHub Enterprise App</option>
                    </select>
                </div>

                @if (IsEnterprise)
                {
                    <div class="mb-3">
                        <label class="form-label">GitHub Enterprise API URL</label>
                        <input class="form-control" @bind="_baseUrl" placeholder="https://github.example.com/api/v3/" />
                    </div>
                }

                @if (IsApp)
                {
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">App ID</label>
                            <input class="form-control" type="number" @bind="_appId" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Installation ID</label>
                            <input class="form-control" type="number" @bind="_installationId" />
                        </div>
                    </div>
                    <div class="mb-3 mt-2">
                        <label class="form-label">App slug</label>
                        <input class="form-control" @bind="_appSlug" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Private key (base64 PEM or PEM)</label>
                        <textarea class="form-control" rows="5" @bind="_privateKey"></textarea>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">Fine-grained PAT</label>
                        <input class="form-control" type="password" autocomplete="off" @bind="_token" />
                        <div class="form-text">The value is sent once to the API and is not returned by connection endpoints.</div>
                    </div>
                }

                <label class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="_testAfterSave" />
                    <span class="form-check-label">Test immediately after saving</span>
                </label>

                <button class="btn btn-primary w-100"
                        data-testid="create-managed-connection"
                        @onclick="CreateAsync"
                        disabled="@_busy">
                    @(_busy ? "Saving…" : "Save connection")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<IntegrationConnectionDto> _connections = Array.Empty<IntegrationConnectionDto>();
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    private string _displayName = "Personal GitHub";
    private IntegrationConnectionMode _mode = IntegrationConnectionMode.GitHubPat;
    private string _baseUrl = "https://api.github.com/";
    private string _token = string.Empty;
    private long? _appId;
    private long? _installationId;
    private string _appSlug = string.Empty;
    private string _privateKey = string.Empty;
    private bool _testAfterSave = true;

    private bool IsApp => _mode is IntegrationConnectionMode.GitHubApp or IntegrationConnectionMode.GitHubEnterpriseApp;
    private bool IsEnterprise => _mode is IntegrationConnectionMode.GitHubEnterprisePat or IntegrationConnectionMode.GitHubEnterpriseApp;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _connections = await Http.GetFromJsonAsync<IReadOnlyList<IntegrationConnectionDto>>(
                "api/v1/admin/connections")
                ?? Array.Empty<IntegrationConnectionDto>();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var credential = new IntegrationCredentialInput(
                IsApp ? null : _token,
                IsApp ? _appId : null,
                IsApp ? _installationId : null,
                IsApp ? _appSlug : null,
                IsApp ? _privateKey : null);

            var command = new CreateIntegrationConnectionCommand(
                "GitHub",
                _displayName.Trim(),
                _mode,
                IsEnterprise ? _baseUrl.Trim() : "https://api.github.com/",
                credential,
                _testAfterSave);

            using var response = await Http.PostAsJsonAsync(
                "api/v1/admin/connections",
                command);
            await EnsureSuccessAsync(response);

            ClearSecretInputs();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync(Guid id)
    {
        _busy = true;
        _error = null;
        try
        {
            using var response = await Http.PostAsync(
                $"api/v1/admin/connections/{id}/test",
                content: null);
            await EnsureSuccessAsync(response);
            await LoadAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleAsync(IntegrationConnectionDto connection)
    {
        _busy = true;
        _error = null;
        try
        {
            using var request = new HttpRequestMessage(
                HttpMethod.Patch,
                $"api/v1/admin/connections/{connection.Id}/enabled")
            {
                Content = JsonContent.Create(new { enabled = !connection.Enabled })
            };
            using var response = await Http.SendAsync(request);
            await EnsureSuccessAsync(response);
            await LoadAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        _busy = true;
        _error = null;
        try
        {
            using var response = await Http.DeleteAsync(
                $"api/v1/admin/connections/{id}");
            await EnsureSuccessAsync(response);
            await LoadAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private void ClearSecretInputs()
    {
        _token = string.Empty;
        _privateKey = string.Empty;
    }

    private static async Task EnsureSuccessAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
            return;
        var body = await response.Content.ReadAsStringAsync();
        throw new InvalidOperationException(
            $"API {(int)response.StatusCode}: {body}");
    }
}
