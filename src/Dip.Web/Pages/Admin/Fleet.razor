@* Purpose: Renders and coordinates this web surface and its user interactions. *@
@page "/admin/fleet"
@using System.Net.Http.Json
@using Dip.Domain.Entities
@inject HttpClient Http
<PageTitle>Agent Fleet | DIP</PageTitle>
<section class="page-heading"><div><div class="eyebrow">Enterprise administration</div><h1>Agent fleet</h1><p>Enrollment, heartbeat, policy version and staged release visibility.</p></div><div class="heading-actions"><button class="btn btn-outline-secondary" @onclick="LoadAsync">Refresh</button></div></section>
@if(_error is not null){<div class="alert alert-danger">@_error</div>}
<div class="card mb-4"><div class="card-header"><strong>Organizations</strong></div><div class="card-body">@if(_organizations.Count==0){<p class="text-muted">No organization tenant has been created.</p>}
    else{<select class="form-select" @onchange="OrganizationChanged"><option value="">Select organization</option>@foreach(var o in _organizations){<option value="@o.Id">@o.Name (@o.Slug)</option>}</select>}</div></div>
@if(_selectedOrganization!=Guid.Empty){<div class="card">
<div class="card-header">
<strong>Registered agents</strong>
<span>@_agents.Count agent(s)</span></div>
<div class="card-body p-0">
<table class="table mb-0">
<thead>
<tr>
<th>Agent</th>
<th>Project</th>
<th>Version</th>
<th>Policy</th>
<th>Status</th>
<th>Last seen</th></tr></thead>
<tbody>@foreach(var a in _agents){
<tr>
<td>@a.AgentId</td>
<td>
<code>@a.ProjectId</code></td>
<td>@a.Version</td>
<td>@a.PolicyVersion</td>
<td>@a.Status</td>
<td>@a.LastSeenAtUtc.ToLocalTime()</td></tr>}</tbody></table></div></div>}
@code{
    private List<OrganizationTenant> _organizations=[];private List<AgentRegistration> _agents=[];private Guid _selectedOrganization;private string? _error;
    protected override Task OnInitializedAsync()=>LoadAsync();
    private async Task LoadAsync(){try{_error=null;
        _organizations=await Http.GetFromJsonAsync<List<OrganizationTenant>>("api/v1/enterprise/organizations")??[];
        if(_selectedOrganization!=Guid.Empty)await LoadAgents();
        }
        catch(Exception ex){_error=ex.Message;
        }}
    private async Task OrganizationChanged(ChangeEventArgs e){Guid.TryParse(e.Value?.ToString(),out _selectedOrganization);await LoadAgents();}
    private async Task LoadAgents(){if(_selectedOrganization==Guid.Empty){_agents=[];
        return;
        }_agents=await Http.GetFromJsonAsync<List<AgentRegistration>>($"api/v1/enterprise/organizations/{_selectedOrganization}/agents")??[];
        }
}
