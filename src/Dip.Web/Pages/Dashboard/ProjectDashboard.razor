@page "/dashboard/{ProjectId:guid}"
@implements IDisposable
@inject ApiClient Api
@inject ProjectState Projects
@inject RealtimeUpdateService Realtime
@inject NavigationManager Navigation

<PageTitle>@(_dashboard?.Name ?? "Project") | DIP</PageTitle>

@if (!string.IsNullOrWhiteSpace(_importWarning))
{
    <div class="alert alert-warning"><strong>Project imported.</strong> @_importWarning</div>
}

@if (_loading)
{
    <LoadingState Message="Loading project overview…" Detail="Combining Project Truth, CI, QA and repository evidence." />
}
else if (_notFound)
{
    <EmptyState Icon="?" Title="Project not found" Description="The selected project is no longer available or you do not have access." ActionText="Back to portfolio" ActionHref="/" />
}
else if (_error is not null)
{
    <ErrorState Message="@_error" Retry="LoadAsync" />
}
else if (_dashboard is not null)
{
    <section class="page-heading project-overview-heading" data-testid="project-overview">
        <div>
            <div class="eyebrow">Project overview</div>
            <h1>@_dashboard.Name</h1>
            <p class="repo-path-large">@ShortRepository(_dashboard.Repository) · @_dashboard.DefaultBranch</p>
        </div>
        <div class="heading-actions">
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync">↻ Refresh</button>
            <a class="btn btn-primary" href="@($"/dashboard/{ProjectId}/qa")">Run QA</a>
        </div>
    </section>

    <div class="project-health-banner @TruthTone(_dashboard.TruthStatus)">
        <div class="health-main">
            <span class="health-orb"></span>
            <div><span>Project state</span><strong>@_dashboard.TruthStatus</strong><small>@_dashboard.TruthSummary</small></div>
        </div>
        <div class="health-meta">
            <span><small>Evidence confidence</small><strong>@_dashboard.EvidenceConfidence</strong></span>
            <span><small>Last evaluated</small><strong>@FormatDate(_dashboard.TruthEvaluatedAtUtc)</strong></span>
        </div>
    </div>

    <div class="overview-metrics mb-4">
        <div class="overview-metric primary-metric">
            <span>Evidence-backed progress</span>
            <strong>@_dashboard.VerifiedProgress.ToString("0.#")%</strong>
            <div class="progress-track"><div class="progress-fill" style="width:@Clamp(_dashboard.VerifiedProgress)%"></div></div>
            <small>Reported: @FormatProgress(_dashboard.ReportedProgress)</small>
        </div>
        <div class="overview-metric">
            <span>Release / delivery risk</span>
            <strong class="@RiskText(_dashboard.RiskLevel)">@_dashboard.RiskLevel</strong>
            <small>Evidence-backed risk</small>
        </div>
        <div class="overview-metric">
            <span>Needs attention</span>
            <strong>@(_dashboard.BlockerCount + _dashboard.ContradictionCount)</strong>
            <small>@_dashboard.BlockerCount blocker(s) · @_dashboard.ContradictionCount mismatch(es)</small>
        </div>
        <div class="overview-metric">
            <span>Quality gate</span>
            <strong>@(_dashboard.QualityGateStatus ?? "Not evaluated")</strong>
            <small>@_dashboard.CriticalIssueCount critical · @_dashboard.WarningIssueCount warning</small>
        </div>
    </div>

    <div class="overview-layout">
        <div class="overview-main">
            <section class="card mb-4">
                <div class="card-header">
                    <div><div class="eyebrow">Priority</div><strong>Needs attention now</strong></div>
                    <span>@_dashboard.TopActions.Count action(s)</span>
                </div>
                <div class="card-body p-0">
                    @if (_dashboard.TopActions.Count == 0 && _dashboard.Blockers.Count == 0)
                    {
                        <div class="compact-empty"><span class="status-dot healthy"></span><div><strong>No immediate action required</strong><small>Current evidence does not identify a blocking action.</small></div></div>
                    }
                    else
                    {
                        <div class="attention-list">
                            @foreach (var blocker in _dashboard.Blockers.Take(4))
                            {
                                <div class="attention-item danger">
                                    <span>!</span>
                                    <div><strong>@blocker.Title</strong><small>@blocker.Detail</small></div>
                                    <StatusBadge Value="blocker.Severity" />
                                </div>
                            }
                            @foreach (var action in _dashboard.TopActions.Take(Math.Max(0, 6 - _dashboard.Blockers.Take(4).Count())))
                            {
                                <div class="attention-item warning">
                                    <span>→</span>
                                    <div><strong>@action</strong><small>Recommended from current project evidence.</small></div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-header"><strong>Development pulse</strong><span>Repository / CI / QA</span></div>
                <div class="card-body">
                    <div class="pulse-grid">
                        <a class="pulse-card" href="@($"/dashboard/{ProjectId}/repository")">
                            <div><span>Repository</span><strong>@RepositoryStatus</strong></div>
                            <small>@RepositoryDetail</small>
                            <b>Open repository →</b>
                        </a>
                        <a class="pulse-card" href="@($"/dashboard/{ProjectId}/ci")">
                            <div><span>CI / Builds</span><strong>@(_dashboard.LatestPipelineStatus ?? "No run")</strong></div>
                            <small>@FormatDate(_dashboard.LatestPipelineFinishedAtUtc)</small>
                            <b>Open CI →</b>
                        </a>
                        <a class="pulse-card" href="@($"/dashboard/{ProjectId}/qa")">
                            <div><span>QA</span><strong>@QaStatus</strong></div>
                            <small>@QaDetail</small>
                            <b>Open QA →</b>
                        </a>
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header"><strong>Recent activity</strong><span>@_dashboard.Timeline.Count event(s)</span></div>
                <div class="card-body p-0">
                    @if (_dashboard.Timeline.Count == 0)
                    {
                        <div class="compact-empty"><span class="status-dot neutral"></span><div><strong>No evidence timeline yet</strong><small>CI, QA, claims and integrations will populate this feed.</small></div></div>
                    }
                    else
                    {
                        <div class="activity-list">
                            @foreach (var item in _dashboard.Timeline.Take(10))
                            {
                                <div class="activity-item">
                                    <span class="activity-dot"></span>
                                    <div><strong>@item.Title</strong><small>@item.Detail</small></div>
                                    <time>@FormatDate(item.AtUtc)</time>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        </div>

        <aside class="overview-side">
            <section class="card mb-4">
                <div class="card-header"><strong>Quick navigation</strong></div>
                <div class="card-body quick-links">
                    <a href="@($"/dashboard/{ProjectId}/repository")"><span>⌘</span><div><strong>Repository</strong><small>Commit, branch and sync state</small></div></a>
                    <a href="@($"/dashboard/{ProjectId}/ci")"><span>▶</span><div><strong>CI / Builds</strong><small>GitHub Actions and pipeline status</small></div></a>
                    <a href="@($"/dashboard/{ProjectId}/qa")"><span>✓</span><div><strong>QA</strong><small>Run QA and inspect findings</small></div></a>
                    <a href="@($"/dashboard/{ProjectId}/intelligence")"><span>◆</span><div><strong>Intelligence</strong><small>Release and decision signals</small></div></a>
                    <a href="@($"/dashboard/{ProjectId}/qa-governance")"><span>◇</span><div><strong>QA Governance</strong><small>Policies, waivers and gates</small></div></a>
                </div>
            </section>

            <section class="card">
                <div class="card-header"><strong>Evidence snapshot</strong></div>
                <div class="card-body evidence-snapshot">
                    <div><span>Supporting QA runs</span><strong>@_dashboard.RecentQaRuns.Count</strong></div>
                    <div><span>Unverified claims</span><strong>@_dashboard.UnverifiedClaimCount</strong></div>
                    <div><span>Open quality issues</span><strong>@_dashboard.OpenIssues.Count</strong></div>
                    <div><span>Decision signals</span><strong>@_dashboard.RecentDecisionIntelligence.Count</strong></div>
                </div>
            </section>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private Dip.Application.Features.Dashboard.ProjectDashboardDetails? _dashboard;
    private GitHubProjectRepositoryDto? _repository;
    private bool _loading = true;
    private bool _notFound;
    private string? _error;
    private string? _importWarning;

    protected override async Task OnInitializedAsync()
    {
        Realtime.ProjectEvent += OnRealtimeEvent;
        Projects.Select(ProjectId);
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _importWarning = ParseQueryValue(uri.Query, "importWarning");
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loading && _dashboard?.ProjectId != ProjectId)
        {
            Projects.Select(ProjectId);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _notFound = false;
        _error = null;
        try
        {
            var dashboardTask = Api.GetProjectAsync(ProjectId);
            var repositoryTask = Api.GetProjectRepositoryAsync(ProjectId);
            _dashboard = await dashboardTask;
            _notFound = _dashboard is null;
            try { _repository = await repositoryTask; }
            catch { _repository = null; }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRealtimeEvent(ProjectRealtimeEventDto evt)
    {
        if (evt.ProjectId != ProjectId)
            return;
        _ = InvokeAsync(LoadAsync);
    }

    private string RepositoryStatus => _repository?.Workspace is null
        ? (_repository?.Connection.Connected == true ? "Not synchronized" : "Not connected")
        : "Synchronized";
    private string RepositoryDetail => _repository?.Workspace is { } workspace
        ? $"{workspace.Branch} · {ShortSha(workspace.CommitSha)} · {workspace.FileCount} files"
        : (_repository?.Warning ?? "Synchronize the GitHub workspace to enable QA.");
    private string QaStatus => _dashboard?.RecentQaRuns.FirstOrDefault()?.Status ?? "No run";
    private string QaDetail => _dashboard?.RecentQaRuns.FirstOrDefault() is { } run
        ? $"{run.FindingCount} findings · {FormatDate(run.CreatedAtUtc)}"
        : "No QA evidence has been collected yet.";

    private static string ShortRepository(string repository) => Uri.TryCreate(repository, UriKind.Absolute, out var uri)
        ? uri.AbsolutePath.Trim('/')
        : repository;
    private static string ShortSha(string sha) => sha.Length <= 8 ? sha : sha[..8];
    private static decimal Clamp(decimal value) => Math.Clamp(value, 0m, 100m);
    private static string FormatProgress(decimal? value) => value is null ? "—" : $"{value:0.#}%";
    private static string FormatDate(DateTimeOffset? value) => value is null ? "Not available" : value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    private static string RiskText(string risk) => risk switch { "High" or "Critical" => "text-danger", "Medium" => "text-warning", _ => "text-success" };
    private static string TruthTone(string status) => status switch { "Healthy" => "healthy", "Attention" => "warning", "AtRisk" or "Blocked" => "danger", _ => "neutral" };
    private static string? ParseQueryValue(string query, string key)
    {
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && Uri.UnescapeDataString(parts[0]).Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(parts[1].Replace('+', ' '));
        }
        return null;
    }

    public void Dispose() => Realtime.ProjectEvent -= OnRealtimeEvent;
}
