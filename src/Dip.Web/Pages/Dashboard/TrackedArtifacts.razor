@* Purpose: Renders the Tracked Artifacts UI and coordinates its pages interactions. *@
@page "/dashboard/{ProjectId:guid}/artifacts"
@using System.Net.Http.Json
@using Dip.Application.Features.Artifacts
@using Dip.Domain.Enums
@inject HttpClient Http

<PageTitle>Artifacts | DIP</PageTitle>

<section class="page-heading" data-testid="tracked-artifacts-page">
    <div>
        <div class="eyebrow">Local / non-Git evidence</div>
        <h1>Tracked artifacts</h1>
        <p>Version history reported by the DIP Project Agent for files that may never enter Git.</p>
    </div>
    <div class="heading-actions">
        <a class="btn btn-outline-secondary" href="@($"/dashboard/{ProjectId}/production")">Production evidence</a>
        <a class="btn btn-outline-secondary" href="@($"/dashboard/{ProjectId}")">Project overview</a>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
    </div>
</section>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_loading)
{
    <LoadingState Message="Loading tracked artifacts…" Detail="Reading non-Git artifact versions and collector evidence." />
}
else if (_artifacts.Count == 0)
{
    <EmptyState Icon="◇" Title="No local artifacts yet" Description="Run Dip.Agent.Windows against a project folder. The agent sends metadata and SHA-256 evidence. Phase 3 can also upload policy-approved screenshots/videos generated inside the project root." />
}
else
{
    <div class="row g-3">
        <div class="col-xl-7">
            <div class="card">
                <div class="card-header d-flex justify-content-between"><strong>Artifacts</strong><span>@_artifacts.Count</span></div>
                <div class="list-group list-group-flush">
                    @foreach (var item in _artifacts)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action @(item.Id == _selected?.Id ? "active" : string.Empty)"
                                @onclick="() => SelectAsync(item)">
                            <div class="d-flex justify-content-between gap-3">
                                <div class="text-truncate">
                                    <strong>@item.DisplayPath</strong>
                                    <div class="small @(item.Id == _selected?.Id ? "text-white-50" : "text-muted")">
                                        @item.Extension · v@item.CurrentVersionNumber · @FormatBytes(item.CurrentSizeBytes)
                                    </div>
                                </div>
                                <span class="badge text-bg-@(item.State == TrackedArtifactLifecycleState.Active ? "success" : "secondary")">@item.State</span>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-5">
            <div class="card">
                <div class="card-header"><strong>Version history</strong></div>
                <div class="card-body">
                    @if (_selected is null)
                    {
                        <p class="text-muted mb-0">Select an artifact.</p>
                    }
                    else if (_versions.Count == 0)
                    {
                        <p class="text-muted mb-0">No versions were returned.</p>
                    }
                    else
                    {
                        <div class="d-grid gap-2">
                            @foreach (var version in _versions)
                            {
                                <div class="border rounded p-2">
                                    <div class="d-flex justify-content-between"><strong>v@version.VersionNumber</strong><span class="badge text-bg-secondary">@version.ChangeKind</span></div>
                                    <div class="small mt-1">@version.DisplayPath</div>
                                    @if (!string.IsNullOrWhiteSpace(version.PreviousDisplayPath))
                                    {
                                        <div class="small text-muted">from @version.PreviousDisplayPath</div>
                                    }
                                    <div class="small text-muted mt-1">@version.ObservedAtUtc.ToLocalTime().ToString("g") · @FormatBytes(version.SizeBytes)</div>
                                    @if (!string.IsNullOrWhiteSpace(version.Sha256))
                                    {
                                        <code class="small">@Short(version.Sha256)</code>
                                    }
                                    <div class="small text-muted">Agent: @version.SourceAgentId · Root: @version.SourceRootId</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private IReadOnlyList<TrackedArtifactDto> _artifacts = Array.Empty<TrackedArtifactDto>();
    private IReadOnlyList<TrackedArtifactVersionDto> _versions = Array.Empty<TrackedArtifactVersionDto>();
    private TrackedArtifactDto? _selected;
    private bool _loading = true;
    private string? _error;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _artifacts = await Http.GetFromJsonAsync<IReadOnlyList<TrackedArtifactDto>>(
                $"api/v1/projects/{ProjectId}/tracked-artifacts?take=500")
                ?? Array.Empty<TrackedArtifactDto>();
            if (_selected is not null)
            {
                _selected = _artifacts.FirstOrDefault(x => x.Id == _selected.Id);
                if (_selected is not null) await LoadVersionsAsync(_selected.Id);
            }
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loading = false; }
    }

    private async Task SelectAsync(TrackedArtifactDto item)
    {
        _selected = item;
        _error = null;
        try { await LoadVersionsAsync(item.Id); }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task LoadVersionsAsync(Guid artifactId)
        => _versions = await Http.GetFromJsonAsync<IReadOnlyList<TrackedArtifactVersionDto>>(
            $"api/v1/projects/{ProjectId}/tracked-artifacts/{artifactId}/versions?take=100")
            ?? Array.Empty<TrackedArtifactVersionDto>();

    private static string Short(string value) => value[..Math.Min(16, value.Length)] + "…";
    private static string FormatBytes(long? value)
    {
        if (!value.HasValue) return "—";
        var size = (double)value.Value;
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var index = 0;
        while (size >= 1024 && index < units.Length - 1) { size /= 1024; index++; }
        return $"{size:0.#} {units[index]}";
    }
}
