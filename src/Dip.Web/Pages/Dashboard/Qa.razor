@* Purpose: Coordinates QA workspace loading and execution while delegating run configuration, findings, debug, and evidence presentation to focused components. *@
@page "/dashboard/{ProjectId:guid}/qa"
@implements IDisposable
@using Dip.Application.Features.GitHubIntegration
@using Dip.Application.Features.QualityAutomation
@using Dip.Web.Components.QA
@inject ApiClient Api
@inject ProjectState Projects
@inject RealtimeUpdateService Realtime

<PageTitle>QA | DIP</PageTitle>

<section class="page-heading" data-testid="qa-page">
    <div>
        <div class="eyebrow">Reviewer focus · QA</div>
        <h1>QA</h1>
        <p>
            Run repository QA, inspect durable findings, and review exact evidence
            without mixing configuration, findings, and debug controls in one surface.
        </p>
    </div>
    <button class="btn btn-outline-secondary"
            type="button"
            @onclick="LoadAsync">
        ↻ Refresh
    </button>
</section>

@if (!string.IsNullOrWhiteSpace(ImportWarning))
{
    <div class="alert alert-warning">
        <strong>GitHub import completed with a warning.</strong>
        @ImportWarning
    </div>
}

@if (WorkspaceStale)
{
    <div class="alert alert-warning">
        <strong>Workspace is stale.</strong>
        GitHub has a newer default-branch commit. The next QA run will
        synchronize the repository before analysis.
    </div>
}

<div class="d-flex gap-2 flex-wrap mb-4">
    <button class="@TabClass("runs")"
            type="button"
            @onclick="ShowRuns">
        Runs & Evidence
    </button>
    <button class="@TabClass("issues")"
            type="button"
            @onclick="ShowIssues">
        Findings (@OpenIssueCount)
    </button>
    <button class="@TabClass("debug")"
            data-testid="qa-autonomous-debug-tab"
            type="button"
            @onclick="ShowDebug">
        Autonomous Debug
    </button>
</div>

@if (_loading)
{
    <LoadingState Message="Loading QA workspace…" />
}
else if (_error is not null)
{
    <ErrorState Message="@_error" Retry="LoadAsync" />
}
else
{
    <QaRunConfiguration ProjectId="@ProjectId"
                        Repository="@_repository"
                        Dashboard="@_dashboard"
                        WorkspaceStale="@WorkspaceStale"
                        Running="@_running"
                        RunError="@_runError"
                        OpenIssueCount="@OpenIssueCount"
                        RunRequested="RunQaAsync" />

    @if (_tab == "issues")
    {
        <QaFindingsPanel ProjectId="@ProjectId"
                         Issues="@_issues"
                         SelectedIssue="@_selectedIssue"
                         SelectedIssueChanged="SelectIssueAsync"
                         PrepareDebugRequested="PrepareDebugAsync" />
    }
    else if (_tab == "debug")
    {
        <QaDebugPanel ProjectId="@ProjectId"
                      Repository="@_repository"
                      SeedIssue="@_debugSeedIssue" />
    }
    else
    {
        <QaEvidenceSummary ProjectId="@ProjectId"
                           LastRun="@_lastRun"
                           Dashboard="@_dashboard"
                           Trends="@_trends" />
    }
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "issue")]
    public Guid? RequestedIssueId { get; set; }

    [SupplyParameterFromQuery(Name = "run")]
    public Guid? RequestedRunId { get; set; }

    [SupplyParameterFromQuery(Name = "autorun")]
    public bool AutoRun { get; set; }

    [SupplyParameterFromQuery(Name = "importWarning")]
    public string? ImportWarning { get; set; }

    private GitHubProjectRepositoryDto? _repository;
    private Dip.Application.Features.Dashboard.ProjectDashboardDetails? _dashboard;
    private QaRunResultDto? _lastRun;
    private IReadOnlyList<QualityIssueClientDto> _issues =
        Array.Empty<QualityIssueClientDto>();
    private IReadOnlyList<QaTrendPointClientDto> _trends =
        Array.Empty<QaTrendPointClientDto>();
    private QualityIssueClientDto? _selectedIssue;
    private QualityIssueClientDto? _debugSeedIssue;

    private string _tab = "runs";
    private bool _loading = true;
    private bool _running;
    private bool _autoRunConsumed;
    private string? _error;
    private string? _runError;

    private int OpenIssueCount =>
        _issues.Count(x => x.Status is "Open" or "Reopened");

    private bool WorkspaceStale =>
        _repository?.Workspace is { } workspace
        && !string.IsNullOrWhiteSpace(
            _repository.Repository?.LatestCommitSha)
        && !workspace.CommitSha.Equals(
            _repository.Repository!.LatestCommitSha,
            StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Realtime.ProjectEvent += OnRealtimeEvent;
        Projects.Select(ProjectId);
        await LoadAsync();

        if (AutoRun && !_autoRunConsumed && _error is null)
        {
            _autoRunConsumed = true;
            await RunQaAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loading && Projects.CurrentProjectId != ProjectId)
        {
            Projects.Select(ProjectId);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var repositoryTask =
                Api.GetProjectRepositoryAsync(ProjectId);
            var dashboardTask =
                Api.GetProjectAsync(ProjectId);
            var issuesTask =
                Api.GetQualityIssuesAsync(ProjectId, 250);
            var trendsTask =
                Api.GetQaTrendsAsync(ProjectId, 30);

            _repository = await repositoryTask;
            _dashboard = await dashboardTask;
            _issues = await issuesTask;
            _trends = await trendsTask;

            var selectedRunId =
                RequestedRunId
                ?? _lastRun?.QaRunId
                ?? _dashboard?.RecentQaRuns.FirstOrDefault()?.Id;

            if (selectedRunId is { } runId)
                _lastRun = await Api.GetQaRunAsync(runId);

            if (RequestedIssueId is { } requestedIssueId)
            {
                _selectedIssue =
                    _issues.FirstOrDefault(x => x.Id == requestedIssueId);

                if (_selectedIssue is not null)
                    _tab = "issues";
            }
            else if (_selectedIssue is not null)
            {
                _selectedIssue =
                    _issues.FirstOrDefault(x => x.Id == _selectedIssue.Id);
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunQaAsync()
    {
        if (_repository is null)
            return;

        _running = true;
        _runError = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            if (_repository.Workspace is null || WorkspaceStale)
            {
                if (!_repository.Connection.Connected)
                {
                    throw new InvalidOperationException(
                        "GitHub is disconnected and no current workspace "
                        + "can be synchronized.");
                }

                await Api.SyncProjectRepositoryAsync(ProjectId);
                _repository =
                    await Api.GetProjectRepositoryAsync(ProjectId);
            }

            var workspace =
                _repository.Workspace
                ?? throw new InvalidOperationException(
                    "Repository synchronization completed without a QA workspace.");

            var command = new QaExecutionCommand(
                ProjectId,
                $"gui:{workspace.Branch}:{ShortSha(workspace.CommitSha)}",
                LanguageId.Auto,
                workspace.WorkspaceRelativePath,
                workspace.CommitSha,
                null,
                null,
                TimeoutSeconds: 300,
                AutomaticallyReproduce: true,
                RecordScreen: false,
                RecordSystemAudio: false);

            _lastRun = await Api.RunQaAsync(command);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _runError = exception.Message;
        }
        finally
        {
            _running = false;
        }
    }

    private Task SelectIssueAsync(QualityIssueClientDto? issue)
    {
        _selectedIssue = issue;
        return Task.CompletedTask;
    }

    private Task PrepareDebugAsync(QualityIssueClientDto issue)
    {
        _debugSeedIssue = issue;
        _tab = "debug";
        return Task.CompletedTask;
    }


    private void ShowRuns() => _tab = "runs";
    private void ShowIssues() => _tab = "issues";
    private void ShowDebug() => _tab = "debug";

    private string TabClass(string value) =>
        _tab == value
            ? "btn btn-primary btn-sm"
            : "btn btn-outline-secondary btn-sm";

    private void OnRealtimeEvent(ProjectRealtimeEventDto evt)
    {
        if (evt.ProjectId == ProjectId
            && (evt.EventType.StartsWith(
                    "qa.",
                    StringComparison.OrdinalIgnoreCase)
                || evt.EventType == "repository.synced"))
        {
            _ = InvokeAsync(LoadAsync);
        }
    }

    private static string ShortSha(string value) =>
        value.Length <= 8 ? value : value[..8];

    public void Dispose() =>
        Realtime.ProjectEvent -= OnRealtimeEvent;
}
