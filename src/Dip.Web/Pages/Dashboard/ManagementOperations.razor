@* Purpose: Coordinates the management cockpit and delegates each operational area to a focused component. *@
@page "/dashboard/{ProjectId:guid}/management"
@using Dip.Application.Features.Management
@inject ApiClient Api

<PageTitle>Management Operations | DIP</PageTitle>

<section class="page-heading" data-testid="management-operations-page">
    <div>
        <div class="eyebrow">Management operations</div>
        <h1>Daily Cockpit</h1>
        <p>
            Detect → decide → assign → approve → verify → close.
            Management state stays evidence-linked to this project.
        </p>
    </div>

    <div class="heading-actions">
        <div class="input-group input-group-sm" style="max-width:320px">
            <span class="input-group-text">My role</span>
            <select class="form-select" @bind="_cockpitOwnerRole">
                <option value="">All accessible work</option>
                @foreach (var role in CurrentActorRoles)
                {
                    <option value="@role">@role</option>
                }
            </select>
            <button class="btn btn-outline-secondary"
                    @onclick="LoadAsync"
                    disabled="@_loading">
                Apply
            </button>
        </div>

        <a class="btn btn-outline-primary"
           href="@($"/dashboard/{ProjectId}/intelligence")">
            Intelligence
        </a>
    </div>
</section>

@if (_loading)
{
    <LoadingState Message="Loading management operations…" />
}
else if (_error is not null)
{
    <ErrorState Message="@_error" Retry="LoadAsync" />
}
else if (_cockpit is not null)
{
    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="alert alert-success">@_notice</div>
    }

    <ManagementCockpitOverview Cockpit="_cockpit"
                               Sync="_sync"
                               Cadence="_cadence"
                               OnCadenceRequested="LoadCadence" />

    <ManagementSectionTabs Tabs="_tabs"
                           Active="_tab"
                           ActiveChanged="SetActiveTab" />

    @if (_tab == "Alerts & approvals")
    {
        <ManagementAlertsApprovalsPanel ProjectId="@ProjectId"
                                        Changed="OnPanelChanged" />
    }
    else if (_tab == "Risk / decisions / actions")
    {
        <ManagementRiskDecisionActionsPanel ProjectId="@ProjectId"
                                            Changed="OnPanelChanged" />
    }
    else if (_tab == "Scope & resources")
    {
        <ManagementScopeResourcesPanel ProjectId="@ProjectId"
                                       Changed="OnPanelChanged" />
    }
    else if (_tab == "RACI & calendar")
    {
        <ManagementRaciCalendarPanel ProjectId="@ProjectId"
                                     Changed="OnPanelChanged" />
    }
    else if (_tab == "Sync & source of truth")
    {
        <ManagementSyncSourcesPanel ProjectId="@ProjectId"
                                    Changed="OnPanelChanged" />
    }
}
