@page "/dashboard/{ProjectId:guid}/management"
@using Dip.Application.Features.Management
@inject ApiClient Api

<PageTitle>Management Operations | DIP</PageTitle>

<section class="page-heading">
    <div><div class="eyebrow">Management operations</div><h1>Daily Cockpit</h1><p>Detect → decide → assign → approve → verify → close. Management state stays evidence-linked to this project.</p></div>
    <div class="heading-actions"><div class="input-group input-group-sm" style="max-width:320px"><span class="input-group-text">My role</span><select class="form-select" @bind="_cockpitOwnerRole"><option value="">All accessible work</option>@foreach(var role in CurrentActorRoles){<option value="@role">@role</option>}</select><button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">Apply</button></div><a class="btn btn-outline-primary" href="@($"/dashboard/{ProjectId}/intelligence")">Intelligence</a></div>
</section>

@if(_loading){<LoadingState Message="Loading management operations…" />}
else if(_error is not null){<ErrorState Message="@_error" Retry="LoadAsync" />}
else if(_cockpit is not null && _management is not null)
{
    @if(!string.IsNullOrWhiteSpace(_notice)){<div class="alert alert-success">@_notice</div>}
    <div class="metric-grid mb-4">
        <div class="metric-card"><span>Health</span><strong>@_cockpit.HealthScore.ToString("0.#")</strong><small>@_cockpit.OverallStatus</small></div>
        <div class="metric-card"><span>Now</span><strong>@_cockpit.Now.Count</strong><small>decision / action items</small></div>
        <div class="metric-card"><span>Approvals</span><strong>@_cockpit.PendingApprovals.Count</strong><small>pending</small></div>
        <div class="metric-card"><span>Sync conflicts</span><strong>@(_sync?.OpenConflicts ?? 0)</strong><small>manual resolution</small></div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-7">
            <div class="card h-100"><div class="card-header"><strong>Do now</strong></div><div class="card-body p-0">
                @if(_cockpit.Now.Count==0){<div class="compact-empty"><span>✓</span><div><strong>No immediate management action</strong><small>There are no current escalations or pending decisions.</small></div></div>}
                else @foreach(var item in _cockpit.Now){<div class="attention-item @(item.Severity=="Critical"?"danger":"warning")"><span>!</span><div><strong>@item.Title</strong><small>@item.Type · @(item.OwnerRole??"Unassigned") · @(item.DueAtUtc?.ToLocalTime().ToString("g")??"no due date")</small><div class="small mt-1">@item.Action</div></div><span class="badge bg-secondary">@item.Severity</span></div>}
            </div></div>
        </div>
        <div class="col-12 col-xl-5">
            <div class="card h-100"><div class="card-header d-flex justify-content-between"><strong>Meeting mode</strong><div class="btn-group btn-group-sm"><button class="btn btn-outline-secondary" @onclick='()=>LoadCadence("daily")'>Daily</button><button class="btn btn-outline-secondary" @onclick='()=>LoadCadence("weekly")'>Weekly</button><button class="btn btn-outline-secondary" @onclick='()=>LoadCadence("release")'>Release</button></div></div><div class="card-body">
                @if(_cadence is not null){<h5>@_cadence.Title</h5><p>@_cadence.Summary</p><ul class="small mb-0">@foreach(var point in _cadence.TalkingPoints.Take(8)){<li>@point</li>}</ul>}
            </div></div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        @foreach(var tab in _tabs){<li class="nav-item"><button class="nav-link @(_tab==tab?"active":"")" @onclick="()=>_tab=tab">@tab</button></li>}
    </ul>

    @if(_tab=="Alerts & approvals")
    {
        <div class="row g-3">
            <div class="col-12 col-xl-7"><div class="card"><div class="card-header"><strong>Operational alerts</strong></div><div class="card-body p-0">
                @foreach(var op in _cockpit.Alerts.Where(x=>x.Visible)){
                    <div class="attention-item @(op.Alert.Severity=="Critical"?"danger":"warning")"><span>!</span><div><strong>@op.Alert.Title</strong><small>@op.Alert.Category · route: @op.RoutedRole · state: @op.State.Status</small><div class="small mt-1">@op.Alert.Explanation</div><div class="small"><b>Next:</b> @op.Alert.RecommendedAction</div></div><div class="d-flex flex-column gap-1"><button class="btn btn-outline-primary btn-sm" @onclick='()=>Alert(op.Alert.Key,"acknowledge")'>Ack</button><button class="btn btn-outline-secondary btn-sm" @onclick='()=>Alert(op.Alert.Key,"snooze")'>Snooze 2h</button><button class="btn btn-outline-success btn-sm" @onclick='()=>Alert(op.Alert.Key,"resolve")'>Resolve</button></div></div>}
            </div></div></div>
            <div class="col-12 col-xl-5"><div class="card mb-3"><div class="card-header"><strong>Pending approvals</strong></div><div class="card-body">
                @if(_approvals is not null) @foreach(var a in _approvals.Items.Where(x=>x.Status=="Pending")){<div class="border rounded p-2 mb-2"><strong>@a.Title</strong><div class="small text-muted">@a.ApprovalType · @a.TargetType:@a.TargetKey · pending @string.Join(", ",a.PendingRoles)</div><div class="input-group input-group-sm mt-2"><select class="form-select" @bind="_approvalActorRole"><option value="">Select bound role</option>@foreach(var role in CurrentActorRoles){<option value="@role">@role</option>}</select><button class="btn btn-outline-success" disabled="@string.IsNullOrWhiteSpace(_approvalActorRole)" @onclick="()=>Respond(a,true)">Approve</button><button class="btn btn-outline-danger" disabled="@string.IsNullOrWhiteSpace(_approvalActorRole)" @onclick="()=>Respond(a,false)">Reject</button></div></div>}
            </div></div>
            <div class="card"><div class="card-header"><strong>Create approval gate</strong></div><div class="card-body form-grid">
                <input class="form-control" placeholder="Key" @bind="_approvalKey"/><input class="form-control" placeholder="Title" @bind="_approvalTitle"/><input class="form-control" placeholder="Type (Release/Scope/Resource)" @bind="_approvalType"/><div class="d-flex gap-2"><input class="form-control" placeholder="Target type" @bind="_approvalTargetType"/><input class="form-control" placeholder="Target key" @bind="_approvalTargetKey"/></div><input class="form-control" placeholder="Required roles, comma separated" @bind="_approvalRoles"/><input class="form-control" type="datetime-local" @bind="_approvalDue"/><button class="btn btn-primary" @onclick="CreateApproval">Create approval</button>
            </div></div></div>
        </div>
    }
    else if(_tab=="Risk / decisions / actions")
    {
        <div class="row g-3">
            <div class="col-12 col-xl-7">
                <div class="card mb-3"><div class="card-header"><strong>Risk register</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Risk</th><th>Exposure</th><th>Owner</th><th>Review</th><th></th></tr></thead><tbody>@foreach(var r in _management.Risks.Items){<tr><td><button class="btn btn-link btn-sm p-0" @onclick="()=>EditRisk(r)">@r.Title</button><div class="small text-muted">@r.Key · @r.Status</div></td><td>@r.ExposureScore.ToString("0.#") @r.ExposureLevel</td><td>@(r.OwnerRole??"—")</td><td>@(r.ReviewDueUtc?.ToLocalTime().ToString("d")??"—")</td><td><button class="btn btn-outline-danger btn-sm" @onclick='()=>Archive("risk",r.Key)'>Archive</button></td></tr>}</tbody></table></div></div>
                <div class="card mb-3"><div class="card-header"><strong>Decisions</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><tbody>@foreach(var d in _management.Decisions.Decisions){<tr><td><button class="btn btn-link btn-sm p-0" @onclick="()=>EditDecision(d)">@d.Title</button><div class="small text-muted">@d.Key · @d.Status</div></td><td>@(d.DecisionOwnerRole??"—")</td><td>@d.OpenActions open action(s)</td><td><button class="btn btn-outline-danger btn-sm" @onclick='()=>Archive("decision",d.Key)'>Archive</button></td></tr>}</tbody></table></div></div>
                <div class="card"><div class="card-header"><strong>Actions</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><tbody>@foreach(var a in _management.Decisions.Actions){<tr><td><button class="btn btn-link btn-sm p-0" @onclick="()=>EditAction(a)">@a.Title</button><div class="small text-muted">@a.Key · @a.Status</div></td><td>@(a.OwnerRole??"—")</td><td>@(a.DueAtUtc?.ToLocalTime().ToString("d")??"—")</td><td><button class="btn btn-outline-danger btn-sm" @onclick='()=>Archive("action",a.Key)'>Archive</button></td></tr>}</tbody></table></div></div>
            </div>
            <div class="col-12 col-xl-5">
                <div class="card mb-3"><div class="card-header"><strong>Create / update risk</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Key" @bind="_riskKey"/><input class="form-control" placeholder="Title" @bind="_riskTitle"/><textarea class="form-control" placeholder="Description" @bind="_riskDescription"></textarea><div class="d-flex gap-2"><select class="form-select" @bind="_riskStatus"><option>Open</option><option>Monitoring</option><option>Mitigated</option><option>Closed</option></select><input class="form-control" placeholder="Category" @bind="_riskCategory"/></div><div class="d-flex gap-2"><input class="form-control" type="number" step="1" min="0" max="100" placeholder="Probability %" @bind="_riskProbability"/><input class="form-control" type="number" step="1" min="0" max="100" placeholder="Impact %" @bind="_riskImpact"/></div><input class="form-control" placeholder="Owner role" @bind="_riskOwner"/><input class="form-control" type="datetime-local" @bind="_riskReview"/><input class="form-control" placeholder="Trigger" @bind="_riskTrigger"/><textarea class="form-control" placeholder="Mitigation" @bind="_riskMitigation"></textarea><input class="form-control" placeholder="Affected items: task:KEY, milestone:KEY" @bind="_riskAffected"/><button class="btn btn-primary" @onclick="SaveRisk">Save risk</button></div></div>
                <div class="card mb-3"><div class="card-header"><strong>Create / update decision</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Key" @bind="_decisionKey"/><input class="form-control" placeholder="Title" @bind="_decisionTitle"/><input class="form-control" placeholder="Decision / proposed choice" @bind="_decisionValue"/><textarea class="form-control" placeholder="Rationale" @bind="_decisionRationale"></textarea><select class="form-select" @bind="_decisionStatus"><option>Proposed</option><option>Pending</option><option>Completed</option><option>Rejected</option></select><input class="form-control" placeholder="Owner role" @bind="_decisionOwner"/><div class="d-flex gap-2"><div class="flex-fill"><label class="form-label small mb-1">Decision due</label><input class="form-control" type="datetime-local" @bind="_decisionDue"/></div><div class="flex-fill"><label class="form-label small mb-1">Decided at</label><input class="form-control" type="datetime-local" @bind="_decisionDecided"/></div></div><input class="form-control" placeholder="Related items: risk:KEY, release:KEY" @bind="_decisionRelated"/><button class="btn btn-primary" @onclick="SaveDecision">Save decision</button></div></div>
                <div class="card"><div class="card-header"><strong>Create / update action</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Key" @bind="_actionKey"/><input class="form-control" placeholder="Title" @bind="_actionTitle"/><div class="d-flex gap-2"><select class="form-select" @bind="_actionPriority"><option>Critical</option><option>High</option><option>Medium</option><option>Low</option></select><select class="form-select" @bind="_actionStatus"><option>Open</option><option>InProgress</option><option>Completed</option><option>Blocked</option></select></div><input class="form-control" placeholder="Owner role" @bind="_actionOwner"/><div class="d-flex gap-2"><input class="form-control" type="datetime-local" @bind="_actionDue"/><input class="form-control" type="number" step="5" min="0" max="100" placeholder="Completion %" @bind="_actionCompletion"/></div><input class="form-control" placeholder="Decision key (optional)" @bind="_actionDecisionKey"/><div class="d-flex gap-2"><input class="form-control" placeholder="Target type" @bind="_actionTargetType"/><input class="form-control" placeholder="Target key" @bind="_actionTargetKey"/></div><button class="btn btn-primary" @onclick="SaveAction">Save action</button></div></div>
            </div>
        </div>
    }
    else if(_tab=="Scope & resources")
    {
        <div class="row g-3"><div class="col-12 col-xl-7">
            <div class="card mb-3"><div class="card-header"><strong>Scope changes</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><tbody>@foreach(var c in _management.ScopeChanges.Changes){<tr><td><button class="btn btn-link btn-sm p-0" @onclick="()=>EditChange(c)">@c.Title</button><div class="small text-muted">@c.Key · @c.Status · @c.ManagementImpact</div></td><td>@c.Priority</td><td><button class="btn btn-outline-danger btn-sm" @onclick='()=>Archive("change",c.Key)'>Archive</button></td></tr>}</tbody></table></div></div>
            <div class="card mb-3"><div class="card-header"><strong>Resource allocations</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><tbody>@foreach(var a in _management.Resources.Allocations){<tr><td><button class="btn btn-link btn-sm p-0" @onclick="()=>EditAllocation(a)">@a.Key</button><div class="small text-muted">@(a.FromWorkstreamKey??"pool") → @a.ToWorkstreamKey</div></td><td>@a.CapacityHoursPerWeek h/week</td><td>@a.Status</td><td><button class="btn btn-outline-danger btn-sm" @onclick='()=>Archive("allocation",a.Key)'>Archive</button></td></tr>}</tbody></table></div></div>
            <div class="card"><div class="card-header"><strong>Cross-project shared resource pools</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Team</th><th>Pool</th><th>Pool limit</th><th></th></tr></thead><tbody>@foreach(var t in _management.Capacity.Teams){<tr><td>@t.Name<div class="small text-muted">@t.Key</div></td><td>@(t.SharedResourceKey??"—")</td><td>@(t.SharedPoolCapacityHoursPerWeek?.ToString("0.#")??"—") h/week</td><td><button class="btn btn-outline-secondary btn-sm" @onclick="()=>EditSharedPool(t)">Edit</button></td></tr>}</tbody></table></div><div class="card-footer small text-muted">Only teams explicitly assigned to the same Shared Resource Key are combined in Portfolio planning; team-name guessing is not used.</div></div>
        </div><div class="col-12 col-xl-5">
            <div class="card mb-3"><div class="card-header"><strong>Create / update scope change</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Key" @bind="_changeKey"/><input class="form-control" placeholder="Title" @bind="_changeTitle"/><textarea class="form-control" placeholder="Description" @bind="_changeDescription"></textarea><div class="d-flex gap-2"><select class="form-select" @bind="_changePriority"><option>Critical</option><option>High</option><option>Medium</option><option>Low</option></select><select class="form-select" @bind="_changeStatus"><option>Proposed</option><option>UnderReview</option><option>Approved</option><option>Rejected</option><option>Deferred</option><option>Completed</option></select></div><input class="form-control" placeholder="Requested by role" @bind="_changeRequestedBy"/><input class="form-control" type="datetime-local" @bind="_changeRequestedAt"/><div class="d-flex gap-2"><input class="form-control" type="number" placeholder="Engineering h" @bind="_changeEng"/><input class="form-control" type="number" placeholder="Art h" @bind="_changeArt"/><input class="form-control" type="number" placeholder="QA h" @bind="_changeQa"/></div><div class="d-flex gap-2"><input class="form-control" type="number" placeholder="Schedule days" @bind="_changeDays"/><input class="form-control" type="number" placeholder="Risk %" @bind="_changeRisk"/></div><input class="form-control" placeholder="Requirement keys, comma separated" @bind="_changeRequirementKeys"/><input class="form-control" placeholder="Workstream keys, comma separated" @bind="_changeWorkstreamKeys"/><input class="form-control" placeholder="Decision key (optional)" @bind="_changeDecisionKey"/><button class="btn btn-primary" @onclick="SaveChange">Save scope change</button></div></div>
            <div class="card mb-3"><div class="card-header"><strong>Create / update resource allocation</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Key" @bind="_allocationKey"/><div class="d-flex gap-2"><input class="form-control" placeholder="From workstream (optional)" @bind="_allocationFrom"/><input class="form-control" placeholder="To workstream" @bind="_allocationTo"/></div><input class="form-control" type="number" step="0.5" placeholder="Hours/week" @bind="_allocationHours"/><div class="d-flex gap-2"><input class="form-control" type="datetime-local" @bind="_allocationStart"/><input class="form-control" type="datetime-local" @bind="_allocationEnd"/></div><select class="form-select" @bind="_allocationStatus"><option>Proposed</option><option>Approved</option><option>Active</option><option>Completed</option></select><textarea class="form-control" placeholder="Rationale" @bind="_allocationRationale"></textarea><input class="form-control" placeholder="Decision key (optional)" @bind="_allocationDecisionKey"/><button class="btn btn-primary" @onclick="SaveAllocation">Save allocation</button></div></div>
            <div class="card"><div class="card-header"><strong>Shared resource membership</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Team key" @bind="_poolTeamKey"/><input class="form-control" placeholder="Shared Resource Key, e.g. graphics-core" @bind="_sharedResourceKey"/><input class="form-control" type="number" step="0.5" min="0.5" placeholder="Shared pool capacity h/week" @bind="_sharedPoolCapacity"/><div class="d-flex gap-2"><button class="btn btn-primary flex-fill" @onclick="SaveSharedPool">Save membership</button><button class="btn btn-outline-secondary flex-fill" @onclick="ClearSharedPool">Remove membership</button></div><div class="small text-muted">Use the same resource key and weekly pool limit in every project that consumes the same people/capacity.</div></div></div>
        </div></div>
    }
    else if(_tab=="RACI & calendar")
    {
        <div class="row g-3"><div class="col-12 col-xl-7">
            <div class="card mb-3"><div class="card-header"><strong>RACI responsibilities</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Target</th><th>R</th><th>A</th><th>C / I</th></tr></thead><tbody>@if(_raci is not null) @foreach(var r in _raci.Items){<tr><td>@r.TargetType:@r.TargetKey</td><td>@(r.ResponsibleRole??"—")</td><td>@(r.AccountableRole??"—")</td><td><small>C: @string.Join(", ",r.ConsultedRoles)<br/>I: @string.Join(", ",r.InformedRoles)</small></td></tr>}</tbody></table></div></div>
            <div class="card mb-3"><div class="card-header"><strong>Formal approval role directory</strong></div><div class="card-body p-0">@if(_roles is not null){<div class="px-3 py-2 small text-muted">Current signed identity: <code>@_roles.CurrentActor</code></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Role</th><th>User</th><th>Status</th></tr></thead><tbody>@foreach(var b in _roles.Bindings){<tr><td>@b.Role</td><td>@(b.DisplayName??b.ActorIdentity)<div class="small text-muted">@b.ActorIdentity</div></td><td>@b.Status</td></tr>}</tbody></table></div>}</div></div>
            <div class="card"><div class="card-header"><strong>Capacity calendars</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><tbody>@if(_calendars is not null) @foreach(var c in _calendars.Calendars){<tr><td>@c.Name<div class="small text-muted">@(c.TeamKey??"project-wide") · @c.TimeZone</div></td><td>@c.RecurringMeetingHoursPerWeek h meetings</td><td>@c.SupportDutyHoursPerWeek h support</td><td>@c.Exceptions.Count exception(s)</td></tr>}</tbody></table></div></div>
        </div><div class="col-12 col-xl-5">
            <div class="card mb-3"><div class="card-header"><strong>Assign RACI</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Assignment key" @bind="_raciKey"/><div class="d-flex gap-2"><input class="form-control" placeholder="Target type" @bind="_raciType"/><input class="form-control" placeholder="Target key" @bind="_raciTarget"/></div><input class="form-control" placeholder="Responsible role" @bind="_raciR"/><input class="form-control" placeholder="Accountable role" @bind="_raciA"/><input class="form-control" placeholder="Consulted roles, comma separated" @bind="_raciC"/><input class="form-control" placeholder="Informed roles, comma separated" @bind="_raciI"/><button class="btn btn-primary" @onclick="SaveRaci">Save RACI</button></div></div>
            <div class="card mb-3"><div class="card-header"><strong>Bind authenticated user → approval role</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Binding key (optional)" @bind="_roleBindingKey"/><input class="form-control" placeholder="Audit identity (login#subject)" @bind="_roleBindingActor"/><input class="form-control" placeholder="Management role, e.g. Tech Lead" @bind="_roleBindingRole"/><input class="form-control" placeholder="Display name (optional)" @bind="_roleBindingName"/><button class="btn btn-primary" @onclick="SaveRoleBinding">Save role binding (Project Owner)</button><div class="small text-muted">Formal approval responses are accepted only when the authenticated audit identity is actively bound to the claimed role.</div></div></div>
            <div class="card mb-3"><div class="card-header"><strong>Work calendar / PTO / holiday</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Calendar key" @bind="_calendarKey"/><input class="form-control" placeholder="Name" @bind="_calendarName"/><input class="form-control" placeholder="Team key (blank = project-wide)" @bind="_calendarTeam"/><div class="d-flex gap-2"><input class="form-control" type="number" step="0.5" placeholder="Hours/day" @bind="_calendarHoursDay"/><input class="form-control" type="number" step="0.5" placeholder="Meeting h/week" @bind="_calendarMeetings"/><input class="form-control" type="number" step="0.5" placeholder="Support h/week" @bind="_calendarSupport"/></div><textarea class="form-control" rows="4" placeholder="Exceptions: YYYY-MM-DD|YYYY-MM-DD|hours|PTO/Holiday|label" @bind="_calendarExceptions"></textarea><button class="btn btn-primary" @onclick="SaveCalendar">Save calendar</button><div class="small text-muted">Calendar deductions are applied directly to Capacity forecasts.</div></div></div>
            <div class="card"><div class="card-header"><strong>Google Calendar → capacity</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Google Calendar ID (e.g. primary)" @bind="_gcalId"/><input class="form-control" type="password" autocomplete="off" placeholder="OAuth access token (not stored)" @bind="_gcalToken"/><div class="d-flex gap-2"><input class="form-control" type="datetime-local" @bind="_gcalFrom"/><input class="form-control" type="datetime-local" @bind="_gcalTo"/></div><div class="small text-muted">PTO/有給・holiday/祝日・meeting・support/on-call events are imported as dated capacity deductions. Existing manual exceptions are preserved.</div><div class="d-flex gap-2"><button class="btn btn-outline-secondary flex-fill" @onclick="()=>RunGoogleCalendar(true)">Dry run</button><button class="btn btn-primary flex-fill" @onclick="()=>RunGoogleCalendar(false)">Sync calendar</button></div>@if(_lastCalendarSync is not null){<div class="alert alert-light border small mb-0">Events @_lastCalendarSync.Events · PTO @_lastCalendarSync.Pto · holidays @_lastCalendarSync.Holidays · meetings @_lastCalendarSync.Meetings · support @_lastCalendarSync.Support · @_lastCalendarSync.CapacityHoursRemoved.ToString("0.#") h deducted</div>}</div></div>
        </div></div>
    }
    else if(_tab=="Sync & source of truth")
    {
        <div class="row g-3"><div class="col-12 col-xl-7">
            <div class="card mb-3"><div class="card-header"><strong>Source of truth rules</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><tbody>@if(_sync is not null) @foreach(var r in _sync.AuthorityRules){<tr><td>@r.DataType</td><td><strong>@r.Authority</strong></td><td>@r.ConflictPolicy</td><td>@r.Status</td></tr>}</tbody></table></div></div>
            <div class="card"><div class="card-header"><strong>Open sync conflicts</strong></div><div class="card-body p-0">@if(_sync is not null) @foreach(var c in _sync.Conflicts.Where(x=>x.Status=="Open")){<div class="attention-item warning"><span>↔</span><div><strong>@c.Provider · @c.ItemKey</strong><small>@c.DataType · detected @c.DetectedAtUtc.ToLocalTime().ToString("g")</small><details class="small mt-1"><summary>Compare values</summary><pre class="small">DIP: @c.DipValue
External: @c.ExternalValue</pre></details></div><div class="d-flex flex-column gap-1"><button class="btn btn-outline-primary btn-sm" @onclick='()=>ResolveConflict(c.Key,"DIP")'>Keep DIP</button><button class="btn btn-outline-secondary btn-sm" @onclick='()=>ResolveConflict(c.Key,"External")'>Keep external</button></div></div>}</div></div>
        </div><div class="col-12 col-xl-5">
            <div class="card mb-3"><div class="card-header"><strong>Authority rule</strong></div><div class="card-body form-grid"><input class="form-control" placeholder="Rule key" @bind="_authorityKey"/><input class="form-control" placeholder="Data type (Action / GoogleSheets:Risks / *)" @bind="_authorityDataType"/><select class="form-select" @bind="_authority"><option>Manual</option><option>DIP</option><option>GitHub</option><option>Jira</option><option>Linear</option><option>GoogleSheets</option><option>External</option></select><select class="form-select" @bind="_conflictPolicy"><option>Manual</option><option>PreferAuthority</option></select><button class="btn btn-primary" @onclick="SaveAuthority">Save authority rule</button></div></div>
