@* Purpose: Renders the Quality Operations UI and coordinates its interactions. *@
@page "/dashboard/{ProjectId:guid}/quality-operations"
@page "/dashboard/{ProjectId:guid}/qa/operations"
@using Dip.Application.Features.QualityAutomation
@using Dip.Web.Services
@inject ApiClient Api

<PageTitle>Quality Operations | DIP</PageTitle>

<section class="qo-heading" data-testid="quality-operations-page">
    <div>
        <div class="eyebrow">Commercial quality operations</div>
        <h1>Quality Operations Command Center</h1>
        <p>Release decision, SLA, reproducibility, production-pipeline risk and verification freshness in one evidence-backed operational view.</p>
    </div>
    <div class="qo-actions">
        <a class="btn btn-outline-secondary" href="@($"/dashboard/{ProjectId}/qa")">QA details</a>
        <a class="btn btn-outline-secondary" data-testid="open-branch-quality" href="@($"/dashboard/{ProjectId}/qa/branches")">Branch Quality</a>
        <a class="btn btn-outline-secondary" href="@($"/dashboard/{ProjectId}/qa-governance")">Governance</a>
        <a class="btn btn-outline-secondary" href="@($"/dashboard/{ProjectId}/project-control-center")">Project Control</a>
        <a class="btn btn-outline-secondary" href="@($"/dashboard/{ProjectId}/management")">Management workspace</a>
        <button class="btn btn-primary" type="button" @onclick="LoadAsync" disabled="@_loading">@(_loading ? "Refreshing…" : "Refresh evidence")</button>
    </div>
</section>

@if (_loading)
{
    <LoadingState Message="Building the commercial QA command center…" />
}
else if (_error is not null)
{
    <ErrorState Message="@_error" Retry="LoadAsync" />
}
else if (_model is not null)
{
    <section class="release-gate @GateClass(_model.ReleaseGate.Status)" data-testid="commercial-release-gate">
        <div class="release-gate-main">
            <div class="eyebrow">Release gate</div>
            <div class="release-label">@_model.ReleaseGate.Label</div>
            <p>@_model.ReleaseGate.Reason</p>
            <div class="release-next"><span>Next action</span><strong>@_model.ReleaseGate.NextAction</strong></div>
        </div>
        <div class="release-score-stack">
            <div class="release-score"><span>Operational quality</span><strong>@_model.ReleaseGate.QualityScore.ToString("0")</strong><small>/ 100</small></div>
            <div class="release-score"><span>Decision confidence</span><strong>@_model.ReleaseGate.DecisionConfidencePercent.ToString("0")%</strong></div>
        </div>
    </section>

    <section class="qo-kpis" aria-label="Quality operations KPIs">
        <article class="qo-kpi"><span>Open issues</span><strong>@_model.Kpis.OpenIssues</strong><small>current quality debt</small></article>
        <article class="qo-kpi danger"><span>P0 blockers</span><strong>@_model.Kpis.P0Blockers</strong><small>must clear or scope out</small></article>
        <article class="qo-kpi warning"><span>SLA breached</span><strong>@_model.Kpis.SlaBreaches</strong><small>response window exceeded</small></article>
        <article class="qo-kpi"><span>Reproduced</span><strong>@_model.Kpis.ReproducedOpenIssues</strong><small>mechanically confirmed</small></article>
        <article class="qo-kpi"><span>24h QA pass rate</span><strong>@_model.Kpis.PassRate24Hours.ToString("0.#")%</strong><small>@_model.Kpis.Runs24Hours run(s)</small></article>
    </section>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-7">
            <section class="qo-panel h-100" data-testid="pm-release-decision-brief">
                <div class="qo-panel-header">
                    <div><div class="eyebrow">PM decision brief</div><h2>@_model.DecisionBrief.Question</h2></div>
                    <span class="qo-owner">@_model.DecisionBrief.OwnerRole</span>
                </div>
                <div class="decision-recommendation @GateClass(_model.ReleaseGate.Status)">@_model.DecisionBrief.Recommendation</div>
                <p class="decision-rationale">@_model.DecisionBrief.Rationale</p>
                <div class="decision-grid">
                    <div>
                        <span>Available options</span>
                        <ol>
                            @foreach (var option in _model.DecisionBrief.Options)
                            {
                                <li>@option</li>
                            }
                        </ol>
                    </div>
                    <div class="residual-risk">
                        <span>Residual risk</span>
                        <p>@_model.DecisionBrief.ResidualRisk</p>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-5">
            <section class="qo-panel h-100" data-testid="verification-coverage">
                <div class="qo-panel-header"><div><div class="eyebrow">Verification coverage</div><h2>Current evidence envelope</h2></div><span class="freshness @FreshnessClass(_model.Coverage.Freshness)">@_model.Coverage.Freshness</span></div>
                <dl class="coverage-list">
                    <div><dt>Latest run</dt><dd>@(_model.Coverage.LatestRunStatus ?? "—")</dd></div>
                    <div><dt>Evidence age</dt><dd>@(_model.Coverage.LatestRunAgeHours?.ToString("0.#") ?? "—") h</dd></div>
                    <div><dt>Production domain</dt><dd>@_model.Coverage.ProductionDomain</dd></div>
                    <div><dt>Languages</dt><dd>@Joined(_model.Coverage.Languages)</dd></div>
                    <div><dt>Engines</dt><dd>@Joined(_model.Coverage.GameEngines)</dd></div>
                </dl>
                <div class="coverage-tags">
                    @foreach (var adapter in _model.Coverage.Adapters.Take(10)) { <span>@adapter</span> }
                    @foreach (var pack in _model.Coverage.CrossCuttingPacks.Take(8)) { <span class="pack">@pack</span> }
                    @if (_model.Coverage.Adapters.Count == 0 && _model.Coverage.CrossCuttingPacks.Count == 0)
                    {
                        <small>No adapter/pack metadata was recorded in the latest run.</small>
                    }
                </div>
            </section>
        </div>
    </div>

    <section class="mb-4" data-testid="quality-operation-lanes">
        <div class="section-title-row"><div><div class="eyebrow">Operational lanes</div><h2>QA work queue by commercial impact</h2></div><button class="btn btn-sm btn-outline-secondary" @onclick="() => SelectLane(null)">Show all</button></div>
        <div class="lane-grid">
            @foreach (var lane in _model.Lanes)
            {
                <button type="button" class="lane-card @LaneClass(lane) @SelectedLaneClass(lane.Key)" @onclick="() => SelectLane(lane.Key)">
                    <div class="lane-card-top"><span>@lane.Title</span><strong>@lane.Count</strong></div>
                    <p>@lane.Description</p>
                    <small>@lane.Status</small>
                </button>
            }
        </div>
    </section>

    <section class="qo-panel mb-4" data-testid="commercial-triage-queue">
        <div class="qo-panel-header queue-header">
            <div><div class="eyebrow">Operational queue</div><h2>Priority triage</h2></div>
            <div class="queue-filters">
                <select class="form-select form-select-sm" @bind="_priorityFilter">
                    <option value="">All priorities</option><option>P0</option><option>P1</option><option>P2</option>
                </select>
                <input class="form-control form-control-sm" @bind="_query" @bind:event="oninput" placeholder="Search issue, category, owner…" />
            </div>
        </div>
        @if (FilteredQueue.Count == 0)
        {
            <div class="compact-empty m-3"><span class="status-dot healthy"></span><div><strong>No issue in this view</strong><small>Change the lane/filter or refresh evidence.</small></div></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table qo-table align-middle mb-0">
                    <thead><tr><th>Priority</th><th>Issue / owner</th><th>Evidence</th><th>SLA</th><th>Impact</th><th>Recommended action</th></tr></thead>
                    <tbody>
                    @foreach (var item in FilteredQueue)
                    {
                        <tr class="@(item.BlocksRelease ? "row-blocker" : item.SlaBreached ? "row-breached" : string.Empty)">
                            <td><span class="priority-pill @item.Priority.ToLowerInvariant()">@item.Priority</span><div class="small text-muted mt-1">@item.Severity</div></td>
                            <td><strong>@item.Title</strong><div class="small text-muted">@item.Category · @item.OwnerRole</div><code class="fingerprint">@ShortFingerprint(item.Fingerprint)</code></td>
                            <td><div>@item.OccurrenceCount occurrence(s)</div><div class="small @(item.MechanicallyReproduced ? "text-danger fw-semibold" : "text-muted")">@(item.MechanicallyReproduced ? "Mechanically reproduced" : "Not mechanically reproduced")</div><div class="small text-muted">confidence @item.ConfidencePercent.ToString("0")%</div></td>
                            <td><strong class="@(item.SlaBreached ? "text-danger" : string.Empty)">@item.AgeHours.ToString("0.#")h / @item.SlaHours.ToString("0.#")h</strong><div class="small">@(item.SlaBreached ? "BREACHED" : "within window")</div></td>
                            <td>@(item.BlocksRelease ? "Release blocker" : item.Priority == "P1" ? "Milestone risk" : "Review")<div class="small text-muted">Last @item.LastSeenAtUtc.ToLocalTime().ToString("g")</div></td>
                            <td><div class="action-copy">@item.RecommendedAction</div><div class="small text-muted mt-1">Residual: @item.ResidualRisk</div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="qo-panel" data-testid="commercial-run-history">
        <div class="qo-panel-header"><div><div class="eyebrow">Verification history</div><h2>Recent QA runs</h2></div><span>@_model.RecentRuns.Count run(s)</span></div>
        @if (_model.RecentRuns.Count == 0)
        {
            <div class="compact-empty m-3"><span class="status-dot neutral"></span><div><strong>No run history</strong><small>Execute QA to establish current release evidence.</small></div></div>
        }
        else
        {
            <div class="run-strip">
                @foreach (var run in _model.RecentRuns)
                {
                    <a class="run-card" href="@($"/dashboard/{ProjectId}/qa/runs/{run.RunId}")">
                        <div class="run-top"><StatusBadge Value="@run.Status" /><span>@run.AgeHours.ToString("0.#")h ago</span></div>
                        <strong>@run.Language</strong>
                        <div class="run-counts"><span>@run.FindingCount findings</span><span class="critical">@run.CriticalFindingCount critical</span><span>@run.WarningFindingCount warnings</span></div>
                    </a>
                }
            </div>
        }
    </section>

    <div class="qo-footnote">Generated @_model.GeneratedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"). Quality score is an operational prioritization score, not a claim that product quality can be reduced to one number.</div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private CommercialQaCommandCenterDto? _model;
    private bool _loading=true;
    private string? _error;
    private string? _selectedLane;
    private string _priorityFilter=string.Empty;
    private string _query=string.Empty;

    private IReadOnlyList<QaOperationsIssueDto> FilteredQueue
    {
        get
        {
            if(_model is null)return Array.Empty<QaOperationsIssueDto>();
            IEnumerable<QaOperationsIssueDto> q=_model.PriorityQueue;
            if(!string.IsNullOrWhiteSpace(_selectedLane))
            {
                var lane=_model.Lanes.FirstOrDefault(x=>x.Key==_selectedLane);
                if(lane is not null){var ids=lane.IssueIds.ToHashSet();q=q.Where(x=>ids.Contains(x.IssueId));}
            }
            if(!string.IsNullOrWhiteSpace(_priorityFilter))q=q.Where(x=>x.Priority.Equals(_priorityFilter,StringComparison.OrdinalIgnoreCase));
            if(!string.IsNullOrWhiteSpace(_query))
            {
                var term=_query.Trim();
                q=q.Where(x=>x.Title.Contains(term,StringComparison.OrdinalIgnoreCase)||x.Category.Contains(term,StringComparison.OrdinalIgnoreCase)||x.OwnerRole.Contains(term,StringComparison.OrdinalIgnoreCase)||x.Fingerprint.Contains(term,StringComparison.OrdinalIgnoreCase));
            }
            return q.Take(100).ToArray();
        }
    }

    protected override Task OnParametersSetAsync()=>LoadAsync();

    private async Task LoadAsync()
    {
        if(ProjectId==Guid.Empty)return;
        _loading=true;_error=null;
        try{_model=await Api.GetCommercialQaCommandCenterAsync(ProjectId,80);}
        catch(Exception ex){_error=ex.Message;}
        finally{_loading=false;}
    }

    private void SelectLane(string? key)=>_selectedLane=key;
    private string SelectedLaneClass(string key)=>_selectedLane==key?"selected":string.Empty;
    private static string GateClass(string status)=>status.ToLowerInvariant() switch{"blocked"=>"gate-blocked","hold"=>"gate-hold","ready"=>"gate-ready",_=>"gate-unknown"};
    private static string FreshnessClass(string value)=>value.ToLowerInvariant() switch{"fresh"=>"fresh","current"=>"current","stale"=>"stale",_=>"unknown"};
    private static string LaneClass(QaOperationsLaneDto lane)=>lane.Status.ToLowerInvariant() switch{"danger"=>"lane-danger","warning"=>"lane-warning","attention"=>"lane-attention",_=>"lane-healthy"};
    private static string Joined(IReadOnlyList<string> values)=>values.Count==0?"—":string.Join(", ",values.Take(8));
    private static string ShortFingerprint(string value)=>string.IsNullOrWhiteSpace(value)?"—":value.Length<=12?value:value[..12];
}
