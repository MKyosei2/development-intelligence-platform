@* Purpose: Presents reviewer-first Project Truth, Release Evidence, and QA Governance while loading broader operational intelligence only on demand. *@
@page "/dashboard/{ProjectId:guid}/intelligence"
@using Dip.Application.Features.Dashboard
@using Dip.Application.Features.QualityGovernance
@using Dip.Application.Features.Release
@using Dip.Web.Components.Intelligence
@inject ApiClient Api

<PageTitle>Verification | DIP</PageTitle>

<section class="page-heading" data-testid="verification-page">
    <div>
        <div class="eyebrow">Reviewer focus · Verification</div>
        <h1>Development Intelligence</h1>
        <p>
            Current evidence first: Project Truth context, release readiness,
            and QA governance. Supporting management and predictive intelligence
            are intentionally secondary.
        </p>
    </div>
    <button class="btn btn-outline-secondary"
            type="button"
            @onclick="LoadPrimaryAsync"
            disabled="@_loading">
        ↻ Refresh
    </button>
</section>

@if (_loading)
{
    <LoadingState Message="Loading verification evidence…" />
}
else if (_error is not null)
{
    <ErrorState Message="@_error" Retry="LoadPrimaryAsync" />
}
else
{
    <ReviewerProjectTruthPanel ProjectId="@ProjectId"
                               Overview="@_overview"
                               Governance="@_qaGovernance" />

    <ReleaseEvidencePanel ProjectId="@ProjectId"
                          Readiness="@_readiness" />

    <ReviewerQaGovernancePanel ProjectId="@ProjectId"
                               Governance="@_qaGovernance" />

    <section class="card mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between gap-3 align-items-center">
            <div>
                <div class="eyebrow">Secondary detail</div>
                <strong>Supporting intelligence</strong>
                <div class="small text-muted">
                    Management, incidents, durable jobs, replay, performance,
                    hardware calibration, and forecasts are available without
                    competing with the reviewer primary path.
                </div>
            </div>
            <button class="btn btn-outline-secondary"
                    type="button"
                    @onclick="ToggleSupporting">
                @(_showSupporting ? "Hide supporting intelligence" : "Load supporting intelligence")
            </button>
        </div>
    </section>

    @if (_showSupporting)
    {
        <SupportingIntelligencePanel ProjectId="@ProjectId" />
    }

    <div class="mt-4">
        <a href="@($"/dashboard/{ProjectId}")">
            ← Project Truth
        </a>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private bool _loading = true;
    private bool _showSupporting;
    private string? _error;
    private IntelligenceDashboardDto? _overview;
    private ReleaseReadinessDto? _readiness;
    private QaGovernanceOverviewDto? _qaGovernance;

    protected override async Task OnParametersSetAsync() =>
        await LoadPrimaryAsync();

    private async Task LoadPrimaryAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var overviewTask =
                Api.GetIntelligenceDashboardAsync(ProjectId);
            var readinessTask =
                Api.GetReleaseReadinessAsync(ProjectId);
            var governanceTask =
                Api.GetQaGovernanceOverviewAsync(ProjectId);

            _overview = await overviewTask;
            _readiness = await readinessTask;
            _qaGovernance = await governanceTask;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleSupporting() =>
        _showSupporting = !_showSupporting;
}
