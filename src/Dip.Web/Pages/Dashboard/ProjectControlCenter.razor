@* Purpose: Renders and coordinates this web surface and its user interactions. *@
@page "/dashboard/{ProjectId:guid}/project-control-center"
@page "/dashboard/{ProjectId:guid}/pm"
@using Dip.Application.Features.Management
@inject ApiClient Api

<PageTitle>Project Control | DIP</PageTitle>

<section class="pm-page" data-testid="project-control-center">
    <header class="pm-hero">
        <div>
            <div class="eyebrow">Project management command center</div>
            <h1>Project Control Center</h1>
            <p>Control plan, schedule, scope, risk, capacity, decisions, approvals and branch quality from one evidence-backed project view.</p>
        </div>
        <div class="hero-actions">
            <a class="btn btn-primary" data-testid="open-management-workspace" href="@($"/dashboard/{ProjectId}/management")">Manage project</a>
            <a class="btn btn-outline-secondary" href="@($"/dashboard/{ProjectId}/qa/branches")">Branch QA</a>
            <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">↻ Refresh</button>
        </div>
    </header>

    <div class="pm-controls">
        <label>Planning horizon<select class="form-select form-select-sm" @bind="_horizonWeeks" @bind:after="LoadAsync"><option value="4">4 weeks</option><option value="8">8 weeks</option><option value="12">12 weeks</option><option value="26">26 weeks</option></select></label>
        <label>Owner role<input class="form-control form-control-sm" placeholder="All roles" @bind="_ownerRole" /></label>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">Apply</button>
    </div>

    @if (_loading)
    {
        <LoadingState Message="Loading project control state…" />
    }
    else if (_error is not null)
    {
        <ErrorState Message="@_error" Retry="LoadAsync" />
    }
    else if (_data is not null)
    {
        <section class="executive-strip @OverallClass(_data.OverallStatus)">
            <div><span>Project</span><strong>@_data.ProjectName</strong><small>@_data.DefaultBranch @ReleaseLabel</small></div>
            <div><span>Overall</span><strong>@_data.OverallStatus</strong><small>evidence-backed state</small></div>
            <div><span>Health</span><strong>@_data.HealthScore.ToString("0.#")</strong><small>/ 100</small></div>
            <div><span>Schedule</span><strong>@_data.Schedule.Status</strong><small>@DelayLabel</small></div>
            <div><span>Milestone progress</span><strong>@_data.Progress.MilestoneProgressPercent.ToString("0.#")%</strong><small>@_data.Progress.CompletedMilestones / @_data.Progress.Milestones completed</small></div>
            <div><span>QA gate</span><strong>@_data.QualityGate.Label</strong><small>@_data.QualityKpis.P0Blockers P0 blocker(s)</small></div>
        </section>

        <div class="pm-kpis">
            <article><span>Active tasks</span><strong>@_data.Kpis.ActiveTasks</strong><small>@_data.Kpis.Workstreams workstreams</small></article>
            <article><span>Critical path</span><strong>@_data.Kpis.CriticalPathItems</strong><small>@_data.Kpis.AtRiskScheduleItems at risk</small></article>
            <article class="@( _data.Kpis.CriticalBlockers>0 ? "danger" : "")"><span>Blockers</span><strong>@_data.Kpis.OpenBlockers</strong><small>@_data.Kpis.CriticalBlockers critical</small></article>
            <article><span>Open risks</span><strong>@_data.Kpis.OpenRisks</strong><small>@_data.Kpis.CriticalRisks critical</small></article>
            <article><span>Pending decisions</span><strong>@_data.Kpis.PendingDecisions</strong><small>@_data.Kpis.OverdueActions overdue actions</small></article>
            <article><span>Approvals</span><strong>@_data.Kpis.PendingApprovals</strong><small>@_data.Kpis.MissingAccountableAssignments missing accountable</small></article>
            <article><span>Scope changes</span><strong>@_data.Kpis.OpenScopeChanges</strong><small>@_data.ScopeChanges.PendingScheduleDays schedule days pending</small></article>
            <article class="@( _data.Kpis.QaP0Blockers>0 ? "danger" : "")"><span>QA P0</span><strong>@_data.Kpis.QaP0Blockers</strong><small>release blockers</small></article>
        </div>

        <div class="pm-columns">
            <section class="pm-card focus-card">
                <div class="card-head"><div><div class="eyebrow">Decision queue</div><h2>What requires my decision today?</h2></div><span>@_data.FocusNow.Count</span></div>
                @if(_data.FocusNow.Count==0){<div class="empty-state">No immediate PM decision is currently queued.</div>}
                else
                {
                    <div class="focus-list">
                    @foreach(var item in _data.FocusNow.Take(8))
                    {
                        <article class="focus-item"><div><span class="severity @SeverityClass(item.Severity)">@item.Severity</span><strong>@item.Title</strong><small>@item.Type · @(item.OwnerRole??"Unassigned") · @Due(item.DueAtUtc)</small></div><p>@item.Action</p></article>
                    }
                    </div>
                }
                <div class="recommended">
                    <strong>Recommended management actions</strong>
                    <ol>@foreach(var action in _data.RecommendedActions.Take(8)){<li>@action</li>}</ol>
                </div>
            </section>

            <section class="pm-card schedule-card">
                <div class="card-head"><div><div class="eyebrow">Delivery control</div><h2>Schedule & critical path</h2></div><span class="status-pill @StatusClass(_data.Schedule.Status)">@_data.Schedule.Status</span></div>
                <div class="schedule-dates"><div><span>Planned finish</span><strong>@Date(_data.Schedule.PlannedFinishUtc)</strong></div><div><span>Forecast finish</span><strong>@Date(_data.Schedule.ForecastFinishUtc)</strong></div><div><span>Delay</span><strong>@_data.Schedule.DelayDays d</strong></div></div>
                <div class="critical-path"><span>Critical path</span>@if(_data.Schedule.CriticalPath.Count==0){<small>No critical path items.</small>}
                    else{@foreach(var node in _data.Schedule.CriticalPath.Take(10)){<code>@node</code>}}</div>
                @if(_data.Schedule.Warnings.Count>0){<ul class="warning-list">@foreach(var warning in _data.Schedule.Warnings.Take(6)){<li>@warning</li>}</ul>}
                <a class="text-link" href="@($"/dashboard/{ProjectId}/management")">Edit tasks, dependencies and schedule →</a>
            </section>
        </div>

        <section class="pm-card">
            <div class="card-head"><div><div class="eyebrow">Execution plan</div><h2>Workstreams & capacity</h2></div><a class="text-link" href="@($"/dashboard/{ProjectId}/management")">Manage plan and resources →</a></div>
            <div class="workstream-grid">
            @foreach(var ws in _data.Workstreams.Take(12))
            {
                <article class="workstream-card">
                    <div><strong>@ws.Name</strong><small>@ws.Team · @ws.Status</small></div>
                    <div class="util-line"><span>Utilization</span><strong>@ws.UtilizationPercent.ToString("0.#")%</strong></div>
                    <div class="util-track"><i style="width:@(Math.Min(100m,ws.UtilizationPercent))%"></i></div>
                    <div class="ws-meta"><span>@ws.ActiveTasks active</span><span>@ws.BlockedTasks blocked</span><span>@ws.RemainingHours.ToString("0.#")h remaining</span></div>
                </article>
            }
            </div>
        </section>

        <div class="pm-columns equal">
            <section class="pm-card">
                <div class="card-head"><div><div class="eyebrow">Milestone control</div><h2>Milestones</h2></div><span>@_data.Progress.AtRiskMilestones at risk</span></div>
                <div class="compact-list">
                @foreach(var m in _data.Milestones.Take(10))
                {
                    <div class="compact-row"><div><strong>@m.Name</strong><small>@m.State · due @Date(m.DueAtUtc)</small></div><div class="row-end"><span>@m.LinkedTaskCompletionPercent.ToString("0.#")%</span><span class="status-pill @StatusClass(m.Readiness)">@m.Readiness</span></div></div>
                }
                </div>
            </section>
            <section class="pm-card">
                <div class="card-head"><div><div class="eyebrow">Quality boundary</div><h2>Release / merge quality</h2></div><span class="gate-pill @GateClass(_data.QualityGate.Status)">@_data.QualityGate.Label</span></div>
                <p>@_data.QualityGate.Reason</p>
                <div class="quality-grid">
                <div>
                <span>Open issues</span>
                <strong>@_data.QualityKpis.OpenIssues</strong></div>
                <div>
                <span>P0</span>
                <strong>@_data.QualityKpis.P0Blockers</strong></div>
                <div>
                <span>SLA breaches</span>
                <strong>@_data.QualityKpis.SlaBreaches</strong></div>
                <div>
                <span>24h pass rate</span>
                <strong>@_data.QualityKpis.PassRate24Hours.ToString("0.#")%</strong></div></div>
                <strong class="next-label">Next action</strong><p>@_data.QualityGate.NextAction</p>
                <div class="button-row"><a class="btn btn-sm btn-primary" href="@($"/dashboard/{ProjectId}/qa/branches")">Inspect branches</a><a class="btn btn-sm btn-outline-secondary" href="@($"/dashboard/{ProjectId}/quality-operations")">QA operations</a></div>
            </section>
        </div>

        <div class="pm-columns equal">
            <section class="pm-card">
                <div class="card-head"><div><div class="eyebrow">Threats to delivery</div><h2>Blockers & risks</h2></div><a class="text-link" href="@($"/dashboard/{ProjectId}/management")">Manage risk register →</a></div>
                <h3>Blockers</h3>
                @foreach(var b in _data.Blockers.Take(5)){<div class="risk-row"><span class="severity @SeverityClass(b.Severity)">@b.Severity</span><div><strong>@b.Title</strong><small>@b.AgeDays days · @b.DownstreamAffected downstream affected</small><p>@b.ManagementAction</p></div></div>}
                <h3 class="mt-3">Risk register</h3>
                @foreach(var r in _data.Risks.Take(6)){<div class="risk-row"><span class="exposure">@r.ExposureScore.ToString("0")</span><div><strong>@r.Title</strong><small>@r.ExposureLevel · @(r.OwnerRole??"Unassigned") · review @Due(r.ReviewDueUtc)</small><p>@r.ManagementAction</p></div></div>}
            </section>
            <section class="pm-card">
                <div class="card-head"><div><div class="eyebrow">Decision cycle</div><h2>Decisions & actions</h2></div><a class="text-link" href="@($"/dashboard/{ProjectId}/management")">Record decision/action →</a></div>
                <h3>Pending decisions</h3>
                @foreach(var d in _data.PendingDecisions.Take(6)){<div class="decision-row"><div><strong>@d.Title</strong><small>@d.Status · @(d.DecisionOwnerRole??"Unassigned") · @Due(d.DecisionDueUtc)</small></div><span>@d.OpenActions action(s)</span></div>}
                <h3 class="mt-3">Open actions</h3>
                @foreach(var a in _data.OpenActions.Take(8)){<div class="decision-row @(a.Overdue?"overdue":"")"><div><strong>@a.Title</strong><small>@a.Priority · @(a.OwnerRole??"Unassigned") · @Due(a.DueAtUtc)</small></div><span>@a.CompletionPercent.ToString("0")%</span></div>}
            </section>
        </div>

        <div class="pm-columns equal">
            <section class="pm-card">
                <div class="card-head"><div><div class="eyebrow">Change control</div><h2>Scope & change requests</h2></div><a class="text-link" href="@($"/dashboard/{ProjectId}/management")">Manage scope →</a></div>
                <div class="quality-grid">
                <div>
                <span>Baseline</span>
                <strong>@(_data.Scope.BaselineKey??"None")</strong></div>
                <div>
                <span>Scope growth</span>
                <strong>@_data.Scope.ScopeGrowthPercent.ToString("0.#")%</strong></div>
                <div>
                <span>High priority incomplete</span>
                <strong>@_data.Scope.IncompleteHighPriority</strong></div>
                <div>
                <span>Proposed changes</span>
                <strong>@_data.ScopeChanges.Proposed</strong></div></div>
                <p class="mt-3">Pending impact: @_data.ScopeChanges.PendingEngineeringHours.ToString("0.#")h engineering · @_data.ScopeChanges.PendingArtHours.ToString("0.#")h art · @_data.ScopeChanges.PendingQaHours.ToString("0.#")h QA · @_data.ScopeChanges.PendingScheduleDays schedule days.</p>
            </section>
            <section class="pm-card">
                <div class="card-head"><div><div class="eyebrow">Governance</div><h2>Dependencies, RACI & approvals</h2></div><a class="text-link" href="@($"/dashboard/{ProjectId}/management")">Manage governance →</a></div>
                <div class="governance-grid">
                <div>
                <span>Dependencies</span>
                <strong>@_data.Dependencies.Links</strong>
                <small>@_data.Dependencies.CriticalLinks critical</small></div>
                <div>
                <span>Dependency cycle</span>
                <strong>@(_data.Dependencies.HasCycle?"YES":"No")</strong>
                <small>@_data.Dependencies.CrossWorkstreamLinks cross-workstream</small></div>
                <div>
                <span>RACI</span>
                <strong>@_data.Raci.Assignments</strong>
                <small>@_data.Raci.MissingAccountable missing accountable</small></div>
                <div>
                <span>Approvals</span>
                <strong>@_data.Approvals.Pending</strong>
                <small>@_data.Approvals.Overdue overdue</small></div></div>
                @if(_data.Dependencies.HasCycle){<div class="alert alert-danger mt-3 mb-0">Dependency cycle detected: @string.Join(" → ",_data.Dependencies.CycleNodes.Take(8))</div>}
            </section>
        </div>

        <section class="pm-card coverage-card">
            <div class="card-head"><div><div class="eyebrow">Commercial PM coverage</div><h2>What this workspace controls</h2></div></div>
            <div class="coverage-grid">
                @Coverage("Plan / tasks",_data.ControlCoverage.PlanAndTasks)
                @Coverage("Schedule / critical path",_data.ControlCoverage.ScheduleAndCriticalPath)
                @Coverage("Milestones",_data.ControlCoverage.Milestones)
                @Coverage("Dependencies",_data.ControlCoverage.Dependencies)
                @Coverage("Risk register",_data.ControlCoverage.Risks)
                @Coverage("Decisions / actions",_data.ControlCoverage.DecisionsAndActions)
                @Coverage("Scope / change control",_data.ControlCoverage.ScopeAndChangeControl)
                @Coverage("Capacity / resources",_data.ControlCoverage.CapacityAndResources)
                @Coverage("RACI",_data.ControlCoverage.Raci)
                @Coverage("Approvals",_data.ControlCoverage.Approvals)
                @Coverage("Branch QA",_data.ControlCoverage.BranchQuality)
                @Coverage("Release quality gate",_data.ControlCoverage.ReleaseQualityGate)
            </div>
        </section>
    }
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private ProjectManagementCommandCenterDto? _data;
    private bool _loading=true;
    private string? _error;
    private int _horizonWeeks=8;
    private string _ownerRole=string.Empty;

    protected override async Task OnParametersSetAsync()=>await LoadAsync();
    private async Task LoadAsync()
    {
        _loading=true;_error=null;
        try{_data=await Api.GetProjectManagementCommandCenterAsync(ProjectId,_horizonWeeks,string.IsNullOrWhiteSpace(_ownerRole)?null:_ownerRole);}
        catch(Exception ex){_error=ex.Message;}
        finally{_loading=false;}
    }

    private RenderFragment Coverage(string label,bool value)=>builder=>
    {
        builder.OpenElement(0,"div");builder.AddAttribute(1,"class","coverage-item");
        builder.OpenElement(2,"span");builder.AddContent(3,value?"✓":"—");builder.CloseElement();
        builder.OpenElement(4,"strong");builder.AddContent(5,label);builder.CloseElement();builder.CloseElement();
    };
    private string ReleaseLabel=>_data?.ReleaseDateUtc is { } r?$"· release {r.ToLocalTime():yyyy-MM-dd}":"· no release date";
    private string DelayLabel=>_data is null?string.Empty:_data.Schedule.DelayDays==0?"on plan":_data.Schedule.DelayDays>0?$"{_data.Schedule.DelayDays}d late":$"{-_data.Schedule.DelayDays}d early";
    private static string Date(DateTimeOffset? value)=>value?.ToLocalTime().ToString("yyyy-MM-dd")??"—";
    private static string Due(DateTimeOffset? value)=>value is null?"no due date":value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    private static string OverallClass(string value)=>value.ToLowerInvariant() switch{"critical"=>"critical","atrisk"=>"risk","attention"=>"attention",_=>"healthy"};
    private static string StatusClass(string value)=>value.ToLowerInvariant().Contains("risk")||value.ToLowerInvariant().Contains("late")?"risk":value.ToLowerInvariant().Contains("block")||value.ToLowerInvariant().Contains("critical")?"critical":"ok";
    private static string GateClass(string value)=>value.ToLowerInvariant() switch{"ready"=>"ready","blocked"=>"blocked","hold"=>"hold",_=>"unknown"};
    private static string SeverityClass(string value)=>value.ToLowerInvariant() switch{"critical" or "blocker"=>"critical","high"=>"high","warning" or "medium"=>"warning",_=>"info"};
}
