@* Purpose: Manages scope changes, resource allocations, and explicitly shared cross-project resource pools. *@
@using Dip.Application.Features.Management
@inject ApiClient Api

@if (_loading)
{
    <LoadingState Message="Loading scope and resources…" />
}
else if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}
else if (_management is not null)
{
    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <div class="card mb-3">
                <div class="card-header"><strong>Scope changes</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var change in _management.ScopeChanges.Changes)
                            {
                                <tr>
                                    <td>
                                        <button class="btn btn-link btn-sm p-0"
                                                @onclick="() => EditChange(change)">
                                            @change.Title
                                        </button>
                                        <div class="small text-muted">
                                            @change.Key · @change.Status · @change.ManagementImpact
                                        </div>
                                    </td>
                                    <td>@change.Priority</td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick='() => ArchiveAsync("change", change.Key)'>
                                            Archive
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><strong>Resource allocations</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var allocation in _management.Resources.Allocations)
                            {
                                <tr>
                                    <td>
                                        <button class="btn btn-link btn-sm p-0"
                                                @onclick="() => EditAllocation(allocation)">
                                            @allocation.Key
                                        </button>
                                        <div class="small text-muted">
                                            @(allocation.FromWorkstreamKey ?? "pool")
                                            → @allocation.ToWorkstreamKey
                                        </div>
                                    </td>
                                    <td>@allocation.CapacityHoursPerWeek h/week</td>
                                    <td>@allocation.Status</td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick='() => ArchiveAsync("allocation", allocation.Key)'>
                                            Archive
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <strong>Cross-project shared resource pools</strong>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Team</th>
                                <th>Pool</th>
                                <th>Pool limit</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var team in _management.Capacity.Teams)
                            {
                                <tr>
                                    <td>
                                        @team.Name
                                        <div class="small text-muted">@team.Key</div>
                                    </td>
                                    <td>@(team.SharedResourceKey ?? "—")</td>
                                    <td>
                                        @(team.SharedPoolCapacityHoursPerWeek?.ToString("0.#") ?? "—")
                                        h/week
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-secondary btn-sm"
                                                @onclick="() => EditSharedPool(team)">
                                            Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer small text-muted">
                    Only teams explicitly assigned to the same Shared Resource Key
                    are combined in Portfolio planning.
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card mb-3">
                <div class="card-header">
                    <strong>Create / update scope change</strong>
                </div>
                <div class="card-body form-grid">
                    <input class="form-control" placeholder="Key" @bind="_changeKey" />
                    <input class="form-control" placeholder="Title" @bind="_changeTitle" />
                    <textarea class="form-control"
                              placeholder="Description"
                              @bind="_changeDescription"></textarea>

                    <div class="d-flex gap-2">
                        <select class="form-select" @bind="_changePriority">
                            <option>Critical</option>
                            <option>High</option>
                            <option>Medium</option>
                            <option>Low</option>
                        </select>
                        <select class="form-select" @bind="_changeStatus">
                            <option>Proposed</option>
                            <option>UnderReview</option>
                            <option>Approved</option>
                            <option>Rejected</option>
                            <option>Deferred</option>
                            <option>Completed</option>
                        </select>
                    </div>

                    <input class="form-control"
                           placeholder="Requested by role"
                           @bind="_changeRequestedBy" />
                    <input class="form-control"
                           type="datetime-local"
                           @bind="_changeRequestedAt" />

                    <div class="d-flex gap-2">
                        <input class="form-control"
                               type="number"
                               placeholder="Engineering h"
                               @bind="_changeEng" />
                        <input class="form-control"
                               type="number"
                               placeholder="Art h"
                               @bind="_changeArt" />
                        <input class="form-control"
                               type="number"
                               placeholder="QA h"
                               @bind="_changeQa" />
                    </div>

                    <div class="d-flex gap-2">
                        <input class="form-control"
                               type="number"
                               placeholder="Schedule days"
                               @bind="_changeDays" />
                        <input class="form-control"
                               type="number"
                               placeholder="Risk %"
                               @bind="_changeRisk" />
                    </div>

                    <input class="form-control"
                           placeholder="Requirement keys"
                           @bind="_changeRequirementKeys" />
                    <input class="form-control"
                           placeholder="Workstream keys"
                           @bind="_changeWorkstreamKeys" />
                    <input class="form-control"
                           placeholder="Decision key"
                           @bind="_changeDecisionKey" />
                    <button class="btn btn-primary" @onclick="SaveChangeAsync">
                        Save scope change
                    </button>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <strong>Create / update resource allocation</strong>
                </div>
                <div class="card-body form-grid">
                    <input class="form-control" placeholder="Key" @bind="_allocationKey" />
                    <div class="d-flex gap-2">
                        <input class="form-control"
                               placeholder="From workstream"
                               @bind="_allocationFrom" />
                        <input class="form-control"
                               placeholder="To workstream"
                               @bind="_allocationTo" />
                    </div>
                    <input class="form-control"
                           type="number"
                           step="0.5"
                           placeholder="Hours/week"
                           @bind="_allocationHours" />
                    <div class="d-flex gap-2">
                        <input class="form-control"
                               type="datetime-local"
                               @bind="_allocationStart" />
                        <input class="form-control"
                               type="datetime-local"
                               @bind="_allocationEnd" />
                    </div>
                    <select class="form-select" @bind="_allocationStatus">
                        <option>Proposed</option>
                        <option>Approved</option>
                        <option>Active</option>
                        <option>Completed</option>
                    </select>
                    <textarea class="form-control"
                              placeholder="Rationale"
                              @bind="_allocationRationale"></textarea>
                    <input class="form-control"
                           placeholder="Decision key"
                           @bind="_allocationDecisionKey" />
                    <button class="btn btn-primary" @onclick="SaveAllocationAsync">
                        Save allocation
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <strong>Shared resource membership</strong>
                </div>
                <div class="card-body form-grid">
                    <input class="form-control"
                           placeholder="Team key"
                           @bind="_poolTeamKey" />
                    <input class="form-control"
                           placeholder="Shared Resource Key"
                           @bind="_sharedResourceKey" />
                    <input class="form-control"
                           type="number"
                           step="0.5"
                           min="0.5"
                           placeholder="Shared pool capacity h/week"
                           @bind="_sharedPoolCapacity" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary flex-fill"
                                @onclick="SaveSharedPoolAsync">
                            Save membership
                        </button>
                        <button class="btn btn-outline-secondary flex-fill"
                                @onclick="ClearSharedPoolAsync">
                            Remove membership
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback<string> Changed { get; set; }

    private ManagementDashboardDto? _management;
    private bool _loading = true;
    private string? _error;

    private string _changeKey = "";
    private string _changeTitle = "";
    private string _changeDescription = "";
    private string _changePriority = "Medium";
    private string _changeStatus = "Proposed";
    private string _changeRequestedBy = "";
    private string _changeRequirementKeys = "";
    private string _changeWorkstreamKeys = "";
    private string _changeDecisionKey = "";
    private decimal _changeEng;
    private decimal _changeArt;
    private decimal _changeQa;
    private decimal _changeRisk;
    private int _changeDays;
    private DateTime? _changeRequestedAt;

    private string _allocationKey = "";
    private string _allocationFrom = "";
    private string _allocationTo = "";
    private string _allocationStatus = "Proposed";
    private string _allocationRationale = "";
    private string _allocationDecisionKey = "";
    private decimal _allocationHours = 8;
    private DateTime _allocationStart = DateTime.Today;
    private DateTime _allocationEnd = DateTime.Today.AddDays(14);

    private string _poolTeamKey = "";
    private string _sharedResourceKey = "";
    private decimal _sharedPoolCapacity = 40m;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _management = await Api.GetManagementDashboardAsync(ProjectId);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveChangeAsync()
    {
        await Api.UpsertChangeRequestAsync(
            new(
                ProjectId,
                _changeKey,
                _changeTitle,
                _changeDescription,
                _changeStatus,
                _changePriority,
                Null(_changeRequestedBy),
                UtcNullable(_changeRequestedAt),
                _changeEng,
                _changeArt,
                _changeQa,
                _changeDays,
                _changeRisk,
                SplitList(_changeRequirementKeys),
                SplitList(_changeWorkstreamKeys),
                Null(_changeDecisionKey),
                null));

        await NotifyAndReloadAsync("Scope change saved.");
    }

    private async Task SaveAllocationAsync()
    {
        await Api.UpsertResourceAllocationAsync(
            new(
                ProjectId,
                _allocationKey,
                _allocationTo,
                _allocationHours,
                Utc(_allocationStart),
                Utc(_allocationEnd),
                _allocationStatus,
                Null(_allocationFrom),
                Null(_allocationRationale),
                Null(_allocationDecisionKey)));

        await NotifyAndReloadAsync("Allocation saved.");
    }

    private async Task SaveSharedPoolAsync()
    {
        await Api.UpsertSharedResourceMembershipAsync(
            ProjectId,
            new(
                ProjectId,
                _poolTeamKey,
                _sharedResourceKey,
                _sharedPoolCapacity));

        await NotifyAndReloadAsync("Shared resource pool membership saved.");
    }

    private async Task ClearSharedPoolAsync()
    {
        await Api.UpsertSharedResourceMembershipAsync(
            ProjectId,
            new(
                ProjectId,
                _poolTeamKey,
                null,
                null));

        await NotifyAndReloadAsync("Shared resource pool membership removed.");
    }

    private async Task ArchiveAsync(string type, string key)
    {
        await Api.ArchiveManagementItemAsync(
            ProjectId,
            new(
                ProjectId,
                type,
                key,
                "web",
                "Archived from management GUI"));

        await NotifyAndReloadAsync("Item archived with history retained.");
    }

    private void EditChange(ChangeRequestDto change)
    {
        _changeKey = change.Key;
        _changeTitle = change.Title;
        _changeDescription = change.Description;
        _changePriority = change.Priority;
        _changeStatus = change.Status;
        _changeRequestedBy = change.RequestedByRole ?? "";
        _changeRequestedAt = change.RequestedAtUtc.LocalDateTime;
        _changeEng = change.EngineeringHoursDelta;
        _changeArt = change.ArtHoursDelta;
        _changeQa = change.QaHoursDelta;
        _changeDays = change.ScheduleDaysDelta;
        _changeRisk = change.RiskDeltaPercent;
        _changeRequirementKeys = string.Join(", ", change.RequirementKeys);
        _changeWorkstreamKeys = string.Join(", ", change.WorkstreamKeys);
        _changeDecisionKey = change.DecisionKey ?? "";
    }

    private void EditAllocation(ResourceAllocationDto allocation)
    {
        _allocationKey = allocation.Key;
        _allocationFrom = allocation.FromWorkstreamKey ?? "";
        _allocationTo = allocation.ToWorkstreamKey;
        _allocationHours = allocation.CapacityHoursPerWeek;
        _allocationStart = allocation.StartUtc.LocalDateTime;
        _allocationEnd = allocation.EndUtc.LocalDateTime;
        _allocationStatus = allocation.Status;
        _allocationRationale = allocation.Rationale ?? "";
        _allocationDecisionKey = allocation.DecisionKey ?? "";
    }

    private void EditSharedPool(TeamCapacityDto team)
    {
        _poolTeamKey = team.Key;
        _sharedResourceKey = team.SharedResourceKey ?? "";
        _sharedPoolCapacity = team.SharedPoolCapacityHoursPerWeek ?? 40m;
    }

    private async Task NotifyAndReloadAsync(string message)
    {
        await LoadAsync();
        await Changed.InvokeAsync(message);
    }

    private static string[] SplitList(string value) =>
        value.Split(
                [',', ';', '\n'],
                StringSplitOptions.TrimEntries
                | StringSplitOptions.RemoveEmptyEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private static string? Null(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();

    private static DateTimeOffset Utc(DateTime value) =>
        new DateTimeOffset(
                value.Kind == DateTimeKind.Unspecified
                    ? DateTime.SpecifyKind(value, DateTimeKind.Local)
                    : value)
            .ToUniversalTime();

    private static DateTimeOffset? UtcNullable(DateTime? value) =>
        value.HasValue
            ? Utc(value.Value)
            : null;
}
