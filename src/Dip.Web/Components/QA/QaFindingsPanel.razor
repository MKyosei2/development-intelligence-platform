@* Purpose: Renders durable QA findings, selected finding evidence, and investigation actions. *@
@inject NavigationManager Navigation

<div class="row g-4" data-testid="qa-findings-panel">
    <div class="col-12 col-xl-7">
        <section class="card">
            <div class="card-header">
                <strong>Durable quality issues</strong>
                <span>@Issues.Count issue(s)</span>
            </div>
            <div class="card-body p-0">
                @if (Issues.Count == 0)
                {
                    <div class="compact-empty">
                        <span class="status-dot healthy"></span>
                        <div>
                            <strong>No durable issues</strong>
                            <small>No quality issue has been recorded for this project.</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Severity</th>
                                    <th>Issue</th>
                                    <th>Status</th>
                                    <th>Occurrences</th>
                                    <th>Last seen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var issue in Issues)
                                {
                                    <tr class="@SelectedClass(issue.Id)"
                                        style="cursor:pointer"
                                        @onclick="() => SelectAsync(issue)">
                                        <td><StatusBadge Value="@issue.Severity" /></td>
                                        <td>
                                            <strong>@issue.Title</strong>
                                            <div class="small text-muted">
                                                @issue.Category ·
                                                <code>@ShortFingerprint(issue.Fingerprint)</code>
                                            </div>
                                        </td>
                                        <td><StatusBadge Value="@issue.Status" /></td>
                                        <td>@issue.OccurrenceCount</td>
                                        <td>@FormatDate(issue.LastSeenAtUtc)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-5">
        <section class="card">
            <div class="card-header">
                <strong>Finding evidence</strong>
            </div>
            <div class="card-body">
                @if (SelectedIssue is null)
                {
                    <p class="text-muted mb-0">
                        Select a finding to inspect its lifecycle and captured evidence.
                    </p>
                }
                else
                {
                    <div class="d-flex justify-content-between gap-3 mb-3">
                        <div>
                            <div class="eyebrow">@SelectedIssue.Category</div>
                            <h2 class="h5 mb-1">@SelectedIssue.Title</h2>
                        </div>
                        <StatusBadge Value="@SelectedIssue.Severity" />
                    </div>

                    <p>@SelectedIssue.Description</p>

                    <div class="settings-list">
                        <div><span>Status</span><strong>@SelectedIssue.Status</strong></div>
                        <div><span>Occurrences</span><strong>@SelectedIssue.OccurrenceCount</strong></div>
                        <div><span>Rule</span><code>@(SelectedIssue.RuleId ?? "—")</code></div>
                        <div><span>Source</span><span>@(SelectedIssue.Source ?? "—")</span></div>
                        <div><span>Last pipeline</span><code>@ShortGuid(SelectedIssue.LastSeenPipelineRunId)</code></div>
                        <div><span>Last seen</span><span>@FormatDate(SelectedIssue.LastSeenAtUtc)</span></div>
                    </div>

                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <button class="btn btn-outline-secondary btn-sm"
                                type="button"
                                @onclick="OpenRelatedPipeline">
                            Open related CI
                        </button>
                        <a class="btn btn-outline-secondary btn-sm"
                           href="@($"/dashboard/{ProjectId}/qa-governance")">
                            Open governance
                        </a>
                        <button class="btn btn-outline-primary btn-sm"
                                type="button"
                                @onclick="PrepareDebugAsync">
                            Debug this issue
                        </button>
                    </div>

                    <div class="mt-3">
                        <div class="small text-muted mb-1">Evidence JSON</div>
                        @if (string.IsNullOrWhiteSpace(SelectedIssue.EvidenceJson))
                        {
                            <div class="compact-empty">
                                <span class="status-dot neutral"></span>
                                <div>
                                    <small>No structured evidence JSON was stored.</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <pre class="small mb-0"
                                 style="white-space:pre-wrap;max-height:320px;overflow:auto">@SelectedIssue.EvidenceJson</pre>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public IReadOnlyList<QualityIssueClientDto> Issues { get; set; } =
        Array.Empty<QualityIssueClientDto>();
    [Parameter] public QualityIssueClientDto? SelectedIssue { get; set; }
    [Parameter] public EventCallback<QualityIssueClientDto?> SelectedIssueChanged { get; set; }
    [Parameter] public EventCallback<QualityIssueClientDto> PrepareDebugRequested { get; set; }

    private Task SelectAsync(QualityIssueClientDto issue) =>
        SelectedIssueChanged.InvokeAsync(issue);

    private Task PrepareDebugAsync() =>
        SelectedIssue is null
            ? Task.CompletedTask
            : PrepareDebugRequested.InvokeAsync(SelectedIssue);

    private void OpenRelatedPipeline()
    {
        if (SelectedIssue is not null)
        {
            Navigation.NavigateTo(
                $"/dashboard/{ProjectId}/ci?run={SelectedIssue.LastSeenPipelineRunId}");
        }
    }

    private string SelectedClass(Guid id) =>
        SelectedIssue?.Id == id ? "table-active" : string.Empty;

    private static string ShortGuid(Guid value) =>
        value.ToString("N")[..8];

    private static string ShortFingerprint(string value) =>
        string.IsNullOrWhiteSpace(value)
            ? "—"
            : value.Length <= 12
                ? value
                : value[..12];

    private static string FormatDate(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
