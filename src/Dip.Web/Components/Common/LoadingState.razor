<div class="empty-state card state-panel" role="status" aria-live="polite">
    <div class="spinner" aria-hidden="true"></div>
    <strong>@Message</strong>
    @if (!string.IsNullOrWhiteSpace(Detail))
    {
        <p class="small text-muted mt-2 mb-0">@Detail</p>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Loading…";
    [Parameter] public string? Detail { get; set; }
}
