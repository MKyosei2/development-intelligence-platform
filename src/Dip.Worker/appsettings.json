{
    "ConnectionStrings":  {
                              "PostgreSql":  ""
                          },
    "Redis":  {
                  "ConnectionString":  "localhost:6379"
              },
    "RedisQueue":  {
                       "StreamName":  "dip:events",
                       "DeadLetterStreamName":  "dip:events:dead-letter",
                       "ConsumerGroup":  "dip-workers",
                       "MaxDeliveryCount":  5,
                       "BlockMilliseconds":  5000
                   },
    "Worker":  {
                   "BatchSize":  50,
                   "PollingIntervalSeconds":  5,
                   "MaxAttempts":  5,
                   "LockSeconds":  60
               },
    "DurableJobs":  {
                        "StreamName":  "dip:jobs",
                        "DeadLetterStreamName":  "dip:jobs:dead-letter",
                        "ConsumerGroup":  "dip-job-workers",
                        "LeaseSeconds":  60,
                        "HeartbeatSeconds":  15,
                        "BlockMilliseconds":  5000,
                        "RecoveryIntervalSeconds":  15
                    },
    "Artifacts":  {
                      "Provider":  "Local",
                      "LocalRoot":  "artifacts/durable",
                      "RetentionCleanupMinutes":  60,
                      "RetentionBatchSize":  100
                  },
    "OperationalMetrics":  {
                               "Port":  9091
                           },
    "AutomaticTriage":  {
                            "IntervalSeconds":  30
                        },
    "GameReplay":  {
                       "WorkspaceRoot":  ".",
                       "AllowPathLookup":  false
                   },
    "ReleaseProvenance":  {
                              "AllowedRoot":  "."
                          }
}
