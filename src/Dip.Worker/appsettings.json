{
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=dip;Username=dip;Password=dip-local-password"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RedisQueue": {
    "StreamName": "dip:events",
    "DeadLetterStreamName": "dip:events:dead-letter",
    "ConsumerGroup": "dip-workers",
    "MaxDeliveryCount": 5,
    "ReadCount": 1,
    "BlockMilliseconds": 5000
  },
  "Worker": {
    "BatchSize": 50,
    "PollingIntervalSeconds": 5,
    "MaxAttempts": 5,
    "LockSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
