{
  "ConnectionStrings": {
    "PostgreSql": ""
  },
  "Queue": {
    "StreamName": "dip:events",
    "DeadLetterStreamName": "dip:events:dead-letter",
    "ConsumerGroup": "dip-workers",
    "MaxDeliveryCount": 5,
    "BlockMilliseconds": 5000
  },
  "Worker": {
    "BatchSize": 50,
    "PollingIntervalSeconds": 5,
    "MaxAttempts": 5,
    "LockSeconds": 60
  },
  "DurableJobs": {
    "StreamName": "dip:jobs",
    "DeadLetterStreamName": "dip:jobs:dead-letter",
    "ConsumerGroup": "dip-job-workers",
    "LeaseSeconds": 60,
    "HeartbeatSeconds": 15,
    "BlockMilliseconds": 5000,
    "RecoveryIntervalSeconds": 15
  },
  "Artifacts": {
    "Provider": "Local",
    "LocalRoot": "artifacts/durable",
    "Minio": {
      "Endpoint": "http://localhost:9000",
      "Bucket": "dip-artifacts",
      "AccessKey": "dipadmin",
      "SecretKey": "dip-local-password",
      "Region": "us-east-1"
    },
    "RetentionCleanupMinutes": 60,
    "RetentionBatchSize": 100
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "OperationalMetrics": {
    "Port": 9091
  },
  "AutomaticTriage": {
    "IntervalSeconds": 30
  },
  "GameReplay": {
    "WorkspaceRoot": ".",
    "AllowPathLookup": false
  },
  "ReleaseProvenance": {
    "AllowedRoot": "."
  },
  "ManagementNotifications": {
    "Enabled": true,
    "ScanIntervalSeconds": 60,
    "SlackWebhookUrl": "",
    "TeamsWebhookUrl": "",
    "Email": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "From": "",
      "To": ""
    },
    "RoleRoutes": {
      "*": [
        "Slack",
        "Teams",
        "Email"
      ]
    },
    "RoleDestinations": {}
  }
}
