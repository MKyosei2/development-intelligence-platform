{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIP Quality Issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "pipelineRunId",
    "category",
    "severity",
    "title",
    "description",
    "status",
    "createdAtUtc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "pipelineRunId": {
      "type": "string",
      "format": "uuid"
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "Info",
        "Warning",
        "Critical"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "Open",
        "Resolved",
        "Ignored"
      ]
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "resolvedAtUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}