{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIP Collector Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectorType",
    "collectorVersion",
    "projectId",
    "commitSha",
    "branch",
    "startedAt",
    "finishedAt",
    "status",
    "metrics",
    "issues",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "collectorType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "collectorVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-.][0-9A-Za-z.-]+)?$"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "cancelled"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "baselineValue": {
          "type": [
            "number",
            "null"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "severity",
        "title",
        "description"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "severity": {
          "enum": [
            "Info",
            "Warning",
            "Critical"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "ruleId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "contentType": {
          "type": [
            "string",
            "null"
          ]
        },
        "sizeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}