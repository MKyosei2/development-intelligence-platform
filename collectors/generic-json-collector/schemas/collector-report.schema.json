{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIP Collector Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "collectorType",
    "collectorVersion",
    "projectId",
    "commitSha",
    "branch",
    "startedAt",
    "finishedAt",
    "status",
    "metrics",
    "issues"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "collectorType": {
      "type": "string",
      "minLength": 1
    },
    "collectorVersion": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "partial"
      ]
    },
    "metrics": {
      "type": "array"
    },
    "issues": {
      "type": "array"
    }
  }
}