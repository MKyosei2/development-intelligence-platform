# DIP Native-first local configuration. Docker/Redis are not required.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dip
POSTGRES_USER=dip
POSTGRES_PASSWORD=change-me-local-only
ConnectionStrings__PostgreSql=Host=127.0.0.1;Port=5432;Database=dip;Username=dip;Password=change-me-local-only

API_PORT=5080
WEB_PORT=5081
ANALYSIS_PORT=8100
WORKER_METRICS_PORT=9091
ASPNETCORE_ENVIRONMENT=Development
DIP_REQUIRE_AUTHENTICATION=false

# Native filesystem roots
DIP_ARTIFACT_ROOT=artifacts/durable
DIP_WORKSPACE_ROOT=.dip/workspaces
DIP_BACKUP_ROOT=artifacts/backups
DIP_BACKUP_OFFSITE_DIRECTORY=
Artifacts__Provider=Local
Artifacts__LocalRoot=artifacts/durable
# Optional external MinIO/S3-compatible artifact store. This remains supported without Docker.
Artifacts__Minio__Endpoint=http://127.0.0.1:9000
Artifacts__Minio__Bucket=dip-artifacts
Artifacts__Minio__AccessKey=
Artifacts__Minio__SecretKey=
Artifacts__Minio__Region=us-east-1

# GitHub repository integration
DIP_GITHUB_WEBHOOK_SECRET=replace-with-a-random-local-secret
DIP_GITHUB_TOKEN=
DIP_GITHUB_APP_ID=
DIP_GITHUB_APP_INSTALLATION_ID=
DIP_GITHUB_APP_SLUG=
DIP_GITHUB_APP_PRIVATE_KEY_BASE64=

# Browser sign-in / RBAC
DIP_GITHUB_OAUTH_CLIENT_ID=
DIP_GITHUB_OAUTH_CLIENT_SECRET=
DIP_GITHUB_ADMIN_LOGIN=
DIP_JWT_SIGNING_KEY=
DIP_JWT_LIFETIME_MINUTES=60

# QA native sandbox
DIP_QA_DEFAULT_TIMEOUT_SECONDS=300
DIP_QA_SANDBOX_MEMORY_MB=4096
DIP_QA_ENABLE_TSAN=0

# Python analysis
DIP_ANALYSIS_API_KEY=native-development-analysis-key
ANALYSIS_APP_ENV=development
ANALYSIS_LOG_LEVEL=INFO
ANALYSIS_TIMEOUT_SECONDS=30
AnalysisService__BaseUrl=http://127.0.0.1:8100
AnalysisService__TimeoutSeconds=30

# Optional integrations
DIP_EXTERNAL_EVENT_INGEST_KEY=
DIP_JIRA_BASE_URL=
DIP_JIRA_EMAIL=
DIP_JIRA_API_TOKEN=
DIP_JIRA_PROJECT_KEY=
DIP_LINEAR_API_KEY=
DIP_LINEAR_TEAM_ID=
DIP_AI_ENDPOINT=
DIP_AI_API_KEY=
DIP_AI_MODEL=evidence-grounded-model
DIP_ALLOW_EXTERNAL_AI=false
DIP_ALLOW_FIX_PROPOSAL=false
DIP_AUTOMATIC_TRIAGE_INTERVAL_SECONDS=30
DIP_REPLAY_ALLOW_PATH_LOOKUP=false

Perforce__Executable=p4
Perforce__WorkingDirectory=
Perforce__TimeoutSeconds=30
Jenkins__BaseUrl=
Jenkins__User=
Jenkins__ApiToken=
Jenkins__TimeoutSeconds=30

DIP_REDMINE_BASE_URL=
DIP_REDMINE_API_KEY=
DIP_REDMINE_PROJECT_IDENTIFIER=
DIP_SLACK_SOURCE_BOT_TOKEN=
DIP_SLACK_SIGNING_SECRET=
DIP_SLACK_SOURCE_CHANNEL_0=
DIP_TEAMS_EVIDENCE_INGEST_KEY=
