# Copy this file to .env for local Docker Compose use.
# Never commit the resulting .env file.

# PostgreSQL
POSTGRES_DB=dip
POSTGRES_USER=dip
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=dipadmin
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Application database connection
ConnectionStrings__PostgreSql=Host=localhost;Port=5432;Database=dip;Username=dip;Password=change-me-local-only

# Application Redis configuration
Redis__ConnectionString=localhost:6379
Redis__InstanceName=dip:
RedisQueue__StreamName=dip:events
RedisQueue__DeadLetterStreamName=dip:events:dead-letter
RedisQueue__ConsumerGroup=dip-workers
RedisQueue__MaxDeliveryCount=5
RedisQueue__ReadCount=1
RedisQueue__BlockMilliseconds=5000

# GitHub integration
GitHub__WebhookSecret=replace-with-a-random-local-secret
GitHub__Token=
GitHub__ProductHeader=development-intelligence-platform
GitHub__QualityReportMarker=<!-- dip-quality-report -->
GitHub__MaxRetryAttempts=3

# Object storage
Storage__Endpoint=localhost:9000
Storage__UseSsl=false
Storage__BucketName=dip-artifacts
Storage__AccessKey=dipadmin
Storage__SecretKey=change-me-local-only

# Python analysis service
AnalysisService__BaseUrl=http://localhost:8000
AnalysisService__TimeoutSeconds=30
