# Copy this file to .env for local Docker Compose use.
# Never commit the resulting .env file.

# PostgreSQL
POSTGRES_DB=dip
POSTGRES_USER=dip
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Application ports
API_PORT=5080
WEB_PORT=5081
ANALYSIS_PORT=8100
ASPNETCORE_ENVIRONMENT=Development

# GitHub webhook / API integration
DIP_GITHUB_WEBHOOK_SECRET=replace-with-a-random-local-secret
DIP_GITHUB_TOKEN=

# GitHub OAuth + JWT + RBAC
DIP_REQUIRE_AUTHENTICATION=false
DIP_GITHUB_OAUTH_CLIENT_ID=
DIP_GITHUB_OAUTH_CLIENT_SECRET=
DIP_GITHUB_ADMIN_LOGIN=
# Generate a 64-byte random key before enabling authentication.
DIP_JWT_SIGNING_KEY=
DIP_JWT_LIFETIME_MINUTES=60

# Python analysis service
DIP_ANALYSIS_API_KEY=
ANALYSIS_APP_ENV=development
ANALYSIS_LOG_LEVEL=INFO
ANALYSIS_TIMEOUT_SECONDS=30

# MinIO (optional profile: storage)
MINIO_ROOT_USER=dipadmin
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Monitoring (optional profile: monitoring)
OTEL_PROMETHEUS_EXPORTER_PORT=8889
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Direct non-container local execution equivalents
ConnectionStrings__PostgreSql=Host=localhost;Port=5432;Database=dip;Username=dip;Password=change-me-local-only
Redis__ConnectionString=localhost:6379
Redis__InstanceName=dip:
AnalysisService__BaseUrl=http://localhost:8100
AnalysisService__TimeoutSeconds=30
