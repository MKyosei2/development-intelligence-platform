# Copy this file to .env for persistent local Docker Compose use.
# Never commit the resulting .env file.
#
# Real-use quick start:
#   1) Copy .env.example -> .env
#   2) Put a GitHub fine-grained PAT in DIP_GITHUB_TOKEN
#      (Metadata/Contents/Actions/Pull requests: Read for the repositories DIP may inspect)
#      OR configure the GitHub App fields below.
#   3) Run: docker compose up -d --build
#   4) Open: http://localhost:5081/projects/import/github
#   5) Import a repository with "Synchronize workspace now" enabled.
#   6) Open the project -> Repository -> QA -> Run QA.
#
# Persistence:
#   Normal `docker compose stop/start` and `docker compose down` keep named volumes.
#   DO NOT use `docker compose down --volumes` unless you intentionally want to
#   erase PostgreSQL, QA workspaces, Redis and artifacts.

# PostgreSQL
POSTGRES_DB=dip
POSTGRES_USER=dip
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Application ports
API_PORT=5080
WEB_PORT=5081
ANALYSIS_PORT=8100
WORKER_METRICS_PORT=9091
ASPNETCORE_ENVIRONMENT=Development

# GitHub webhook / repository API integration
DIP_GITHUB_WEBHOOK_SECRET=replace-with-a-random-local-secret

# Simplest local repository connection:
# Create a fine-grained personal access token restricted to repositories DIP may inspect.
# Recommended repository permissions:
#   Metadata: Read
#   Contents: Read
#   Actions: Read
#   Pull requests: Read
# Add Issues: Read only if you want issue metadata exposed to adjacent integrations.
DIP_GITHUB_TOKEN=

# GitHub App repository connection (recommended for a shared/hosted deployment)
# Create/install a GitHub App with Metadata/Contents/Actions/Pull requests read permissions.
DIP_GITHUB_APP_ID=
DIP_GITHUB_APP_INSTALLATION_ID=
DIP_GITHUB_APP_SLUG=
DIP_GITHUB_APP_PRIVATE_KEY_BASE64=

# GitHub OAuth + JWT + RBAC
# For a single-user localhost setup, leave authentication disabled and use the
# repository token/App above only for server-to-GitHub access.
# Enable this only after OAuth Client ID/Secret and JWT signing key are configured.
DIP_REQUIRE_AUTHENTICATION=false
DIP_GITHUB_OAUTH_CLIENT_ID=
DIP_GITHUB_OAUTH_CLIENT_SECRET=
DIP_GITHUB_ADMIN_LOGIN=
DIP_JWT_SIGNING_KEY=
DIP_JWT_LIFETIME_MINUTES=60

# Python analysis service
DIP_ANALYSIS_API_KEY=
ANALYSIS_APP_ENV=development
ANALYSIS_LOG_LEVEL=INFO
ANALYSIS_TIMEOUT_SECONDS=30

# Durable artifacts
DIP_ARTIFACT_PROVIDER=Local
DIP_ARTIFACT_BUCKET=dip-artifacts
DIP_ARTIFACT_REGION=us-east-1

# MinIO (optional profile: storage)
MINIO_ROOT_USER=dipadmin
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Monitoring (optional profile: monitoring)
OTEL_PROMETHEUS_EXPORTER_PORT=8889
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Direct non-container local execution equivalents
ConnectionStrings__PostgreSql=Host=localhost;Port=5432;Database=dip;Username=dip;Password=change-me-local-only
Redis__ConnectionString=localhost:6379
Redis__InstanceName=dip:
AnalysisService__BaseUrl=http://localhost:8100
AnalysisService__TimeoutSeconds=30

# Development Intelligence expansion
DIP_AUTOMATIC_TRIAGE_INTERVAL_SECONDS=30
DIP_REPLAY_ALLOW_PATH_LOOKUP=false
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Project Control integrations (optional)
Perforce__Executable=p4
Perforce__WorkingDirectory=
Perforce__TimeoutSeconds=30
Jenkins__BaseUrl=
Jenkins__User=
Jenkins__ApiToken=
Jenkins__TimeoutSeconds=30

# Project Intelligence Layer sources (optional)
DIP_REDMINE_BASE_URL=
DIP_REDMINE_API_KEY=
DIP_REDMINE_PROJECT_IDENTIFIER=
DIP_SLACK_SOURCE_BOT_TOKEN=
DIP_SLACK_SIGNING_SECRET=
DIP_SLACK_SOURCE_CHANNEL_0=
DIP_TEAMS_EVIDENCE_INGEST_KEY=
