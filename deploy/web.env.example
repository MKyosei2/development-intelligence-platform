# Hosted Web deployment only. Copy to deploy/web.env and replace every CHANGE_ME value.
DIP_PUBLIC_HOST=dip.example.com

POSTGRES_DB=dip
POSTGRES_USER=dip
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

# Production authentication is mandatory in docker-compose.web.yml.
DIP_GITHUB_OAUTH_CLIENT_ID=CHANGE_ME
DIP_GITHUB_OAUTH_CLIENT_SECRET=CHANGE_ME
DIP_GITHUB_ADMIN_LOGIN=CHANGE_ME_GITHUB_LOGIN
DIP_JWT_SIGNING_KEY=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS_0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ
DIP_JWT_LIFETIME_MINUTES=60

# GitHub webhook validation.
DIP_GITHUB_WEBHOOK_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_WEBHOOK_SECRET

# Optional: GitHub App repository picker/import. Leave blank only if that feature is not used.
DIP_GITHUB_APP_ID=
DIP_GITHUB_APP_INSTALLATION_ID=
DIP_GITHUB_APP_SLUG=
DIP_GITHUB_APP_PRIVATE_KEY_BASE64=
DIP_GITHUB_TOKEN=

# Optional analysis/observability settings.
DIP_ANALYSIS_API_KEY=
ANALYSIS_LOG_LEVEL=INFO
ANALYSIS_TIMEOUT_SECONDS=30
DIP_OTLP_ENDPOINT=http://127.0.0.1:4317
