# DIP Native-first production environment. No container registry or Redis daemon is required.
DIP_PUBLIC_HOST=
DIP_PUBLIC_READ_ONLY=true

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dip
POSTGRES_USER=dip
POSTGRES_PASSWORD=

# Absolute production filesystem paths.
DIP_ARTIFACT_ROOT=/srv/dip/data/artifacts
DIP_WORKSPACE_ROOT=/srv/dip/data/workspaces
DIP_BACKUP_ROOT=/srv/dip/backups
# Must point to a separately mounted filesystem for production deployment.
DIP_BACKUP_OFFSITE_DIRECTORY=/mnt/dip-offsite

# The default production path is native local storage. External MinIO remains optional.
Artifacts__Provider=Local
Artifacts__LocalRoot=/srv/dip/data/artifacts
Artifacts__Minio__Endpoint=
Artifacts__Minio__Bucket=dip-artifacts
Artifacts__Minio__AccessKey=
Artifacts__Minio__SecretKey=
Artifacts__Minio__Region=us-east-1

DIP_GITHUB_OAUTH_CLIENT_ID=
DIP_GITHUB_OAUTH_CLIENT_SECRET=
DIP_GITHUB_ADMIN_LOGIN=
DIP_JWT_SIGNING_KEY=
DIP_JWT_LIFETIME_MINUTES=60
DIP_GITHUB_WEBHOOK_SECRET=
DIP_GITHUB_APP_ID=
DIP_GITHUB_APP_INSTALLATION_ID=
DIP_GITHUB_APP_SLUG=
DIP_GITHUB_APP_PRIVATE_KEY_BASE64=
DIP_GITHUB_TOKEN=

DIP_ANALYSIS_API_KEY=
ANALYSIS_LOG_LEVEL=INFO
ANALYSIS_TIMEOUT_SECONDS=30
DIP_OTLP_ENDPOINT=http://127.0.0.1:4317

DIP_EXTERNAL_EVENT_INGEST_KEY=
DIP_JIRA_BASE_URL=
DIP_JIRA_EMAIL=
DIP_JIRA_API_TOKEN=
DIP_JIRA_PROJECT_KEY=
DIP_LINEAR_API_KEY=
DIP_LINEAR_TEAM_ID=

# Root-cause/debug intelligence is deterministic and local. No external AI endpoint is configured.
DIP_MANAGEMENT_NOTIFICATIONS_ENABLED=true
DIP_MANAGEMENT_NOTIFICATION_SCAN_SECONDS=60
DIP_SLACK_WEBHOOK_URL=
DIP_TEAMS_WEBHOOK_URL=
DIP_SMTP_HOST=
DIP_SMTP_PORT=587
DIP_SMTP_ENABLE_SSL=true
DIP_SMTP_USERNAME=
DIP_SMTP_PASSWORD=
DIP_SMTP_FROM=
DIP_MANAGEMENT_EMAIL_TO=
