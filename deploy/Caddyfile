{$DIP_PUBLIC_HOST} {
    encode zstd gzip
    @api path /api/* /hubs/*
    handle @api { reverse_proxy api:8080 }
    handle { reverse_proxy web:8080 }
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
